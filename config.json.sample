{
  "app": {
    "name": "Auth Gateway",
    "subtitle": "Scan the QR code with your authenticated mobile device to approve access for this desktop.",
    "footerText": "Protected Gateway"
  },
  "server": {
    "port": 3000,
    "host": "0.0.0.0",
    "baseUrl": "https://auth.example.com"
  },
  "downstream": {
    "targetUrl": "http://downstream-app:3000"
  },
  "session": {
    "authCookieName": "gateway_auth_token",
    "approverCookieName": "gateway_approver_session",
    "sessionTtlHours": 72,
    "qrSessionTtlMs": 120000,
    "approverTtlDays": 30
  },
  "publicBypass": {
    "enabled": false,
    "paths": [],
    "pattern": ""
  }
}
