<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { extraCss: null }) %>
  <title><%= title %> - <%= config.app.name %></title>
</head>
<body>
  <div class="ambient-glow"></div>
  <div class="card card-sm">
    <% const isSuccess = type === 'success'; %>
    <% const color = isSuccess ? '#10b981' : '#ef4444'; %>
    <% const bg = isSuccess ? 'rgba(16, 185, 129, 0.15)' : 'rgba(239, 68, 68, 0.15)'; %>
    <div style="width: 64px; height: 64px; border-radius: 50%; background: <%= bg %>; border: 2px solid <%= color %>; color: <%= color %>; display: inline-flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem auto;">
      <svg style="width: 32px; height: 32px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <% if (isSuccess) { %>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        <% } else { %>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        <% } %>
      </svg>
    </div>
    <h1><%= title %></h1>
    <p class="desc"><%= message %></p>
    <% if (actionUrl) { %>
      <a href="<%= actionUrl %>" class="btn"><%= actionLabel || 'Continue' %></a>
    <% } %>
  </div>
  <%- include('partials/pwa-sw') %>
</body>
</html>