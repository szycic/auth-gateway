<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { extraCss: ['/css/login.css', '/css/approve.css'] }) %>
  <title><%= matchedService ? `${matchedService.name} - ${config.app.name}` : `Sign in to ${config.app.name}` %></title>
  <script src="/socket.io/socket.io.js"></script>
  <style>
    .fido-quick-auth {
      margin-top: 1rem;
      text-align: center;
    }
    .btn-fido-direct {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      background: rgba(56, 189, 248, 0.08);
      border: 1px solid rgba(56, 189, 248, 0.25);
      color: #38bdf8;
      padding: 0.55rem 1rem;
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
      width: 100%;
    }
    .btn-fido-direct:hover {
      background: rgba(56, 189, 248, 0.16);
      border-color: rgba(56, 189, 248, 0.4);
      color: #7dd3fc;
      transform: translateY(-1px);
    }
    .fido-direct-status {
      margin-top: 0.5rem;
      font-size: 0.8rem;
      color: #f87171;
      display: none;
    }
  </style>
</head>
<body>
  <div class="ambient-glow"></div>

  <div class="card card-md" id="mainCard">
    <div class="logo-container">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
    </div>

    <h1 id="pageTitle"><%= isFromOpenHandle ? 'Authentication Required' : config.app.name %></h1>
    <p class="subtitle" id="pageSubtitle" <%- isFromOpenHandle ? 'style="display: none;"' : '' %>><%= config.app.subtitle %></p>

    <% if (matchedService) { %>
      <div class="service-target-badge" id="serviceBadge" <%- isFromOpenHandle ? 'style="display: none;"' : '' %>>
        <div class="service-target-main">
          Signing in to <span class="service-target-name"><%= matchedService.name %></span>
        </div>
      </div>
    <% } %>

    <% if (isFromOpenHandle) { %>
      <div class="monit-container" id="openHandleMonit">
        <p class="monit-desc">
          This part of <strong class="monit-service-name"><%= matchedService ? matchedService.name : 'the service' %></strong> requires additional authentication to access.
        </p>
        <div class="monit-actions">
          <button type="button" class="btn-authorize" id="btnAuthorize" onclick="revealQrLogin()">
            Authenticate
          </button>
          <a href="<%= fromUrl %>" class="btn-go-back" id="btnGoBack" onclick="handleGoBack(event, '<%= fromUrl %>')">
            ← Go Back
          </a>
        </div>
      </div>
    <% } %>

    <div id="qrAuthSection" <%- isFromOpenHandle ? 'style="display: none;"' : '' %>>
      <div class="qr-frame" id="qrContainer">
        <img id="qrImage" src="" alt="QR Authorization Code" style="display: none;">

        <div class="overlay active" id="loadingOverlay">
          <div class="spinner"></div>
          <p style="font-size: 0.875rem; color: #cbd5e1;">Generating secure QR...</p>
        </div>

        <div class="overlay" id="expiredOverlay">
          <svg style="width: 36px; height: 36px; color: #f59e0b; margin-bottom: 0.5rem;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p style="font-size: 0.875rem; color: #e2e8f0; margin-bottom: 0.75rem;">Session Expired</p>
          <button class="btn-refresh" onclick="initQrSession()">Refresh Session</button>
        </div>
      </div>

      <div class="pair-code-card" id="pairCodeCard">
        <div class="pair-code-digits" id="pairCodeDigits">•••• - ••••</div>
      </div>

      <div class="status-bar" id="statusBar">
        <div class="status-dot"></div>
        <span id="statusText">Awaiting approval (<span id="timerCount">120</span>s)</span>
      </div>

      <% if (typeof hasFidoKeys !== 'undefined' && hasFidoKeys && typeof authMethod !== 'undefined' && authMethod === 'fido') { %>
        <div class="fido-quick-auth" id="fidoQuickAuth">
          <button type="button" class="btn-fido-direct" id="btnFidoDirect" onclick="openFidoMonit()">
            <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
            <span>Sign in with Security Key</span>
          </button>
          <div class="fido-direct-status" id="fidoDirectStatus"></div>
        </div>
      <% } %>
    </div>

    <div class="footer">
      <%= config.app.footerText %>
    </div>
  </div>

  <% if (typeof hasFidoKeys !== 'undefined' && hasFidoKeys && typeof authMethod !== 'undefined' && authMethod === 'fido') { %>
  <%
    const servicesList = ((typeof services !== 'undefined' && services) || (config && config.services) || []).filter(svc => !svc.disableService && !svc.disableAuth);
    const targetService = (typeof matchedService !== 'undefined' && matchedService && !matchedService.disableAuth) ? matchedService : null;
    const targetServiceId = targetService ? targetService.id : null;
  %>
  <!-- FIDO Approval Monit Modal (Shown AFTER key touch) -->
  <div class="fido-modal-overlay" id="fidoAuthModal" style="display: none;" onclick="if(event.target===this)closeFidoMonit()">
    <div class="card card-md fido-approval-card" onclick="event.stopPropagation()">
      <div class="header">
        <div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-bottom: 0.35rem;">
          <span class="badge-verified-key">
            <svg style="width: 14px; height: 14px; color: #34d399;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Security Key Verified
          </span>
        </div>
        <h1>Authorize Desktop Access?</h1>
      </div>

      <form id="fidoApprovalForm" onsubmit="return handleFidoApprovalSubmit(event)">
        <div class="device-info">
          <div class="info-row">
            <span class="info-label">Detected Device</span>
            <span class="info-val"><%= typeof friendlyDevice !== 'undefined' ? friendlyDevice : 'This Computer' %></span>
          </div>
          <% if (typeof clientIp !== 'undefined' && clientIp) { %>
          <div class="info-row">
            <span class="info-label">IP Address</span>
            <span class="info-val"><%= clientIp %></span>
          </div>
          <% } %>
          <% if (targetService) { %>
          <div class="info-row">
            <span class="info-label">Target Platform</span>
            <span class="info-val" style="color: #38bdf8; font-weight: 700;"><%= targetService.name %></span>
          </div>
          <% } %>
        </div>

        <div class="name-box">
          <label for="fidoCustomName">Device Name</label>
          <div class="name-input-wrapper">
            <input
              type="text"
              id="fidoCustomName"
              name="customName"
              value="<%= typeof friendlyDevice !== 'undefined' ? friendlyDevice : '' %>"
              placeholder="e.g. Work Laptop, Living Room PC"
              maxlength="40"
              autocomplete="off"
              spellcheck="false"
            >
          </div>
        </div>

        <!-- Option to login as Approver -->
        <label class="trust-box approver-box" id="approverToggleBox">
          <input type="checkbox" id="loginAsApproverToggle" name="loginAsApprover" value="true" onchange="handleApproverToggle(this)">
          <div class="trust-text">
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.15rem;">
              <span class="trust-title" style="margin-bottom: 0;">Login as Approver</span>
              <span class="badge-approver-chip">
                <svg style="width: 10px; height: 10px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                Approver
              </span>
            </div>
            <span class="trust-desc">Grant full administrative privileges and device approval on this browser.</span>
          </div>
        </label>

        <!-- Service Access Restriction Toggle -->
        <% if (targetService) { %>
        <label class="trust-box" id="onlyPlatformBox">
          <input type="checkbox" id="onlyPlatformToggle" data-target-id="<%= targetService.id %>" onchange="handleOnlyPlatformToggle(this, '<%= targetService.id %>')">
          <div class="trust-text">
            <span class="trust-title">Grant access only to <%= targetService.name %></span>
            <span class="trust-desc">Lock this session exclusively to <%= targetService.name %> (uncheck other services).</span>
          </div>
        </label>
        <% } else { %>
        <label class="trust-box" id="onlyPlatformBox">
          <input type="checkbox" id="onlyPlatformToggle" onchange="handleGenericPlatformToggle(this)">
          <div class="trust-text">
            <span class="trust-title">Restrict to single platform</span>
            <span class="trust-desc">Limit this device to one service instead of full access.</span>
          </div>
        </label>
        <div id="platformPickerWrap" style="display: none; margin-top: -0.5rem; margin-bottom: 1rem; width: 100%;">
          <label style="display: block; font-size: 0.75rem; font-weight: 600; color: #94a3b8; margin-bottom: 0.35rem;">Select allowed platform:</label>
          <select id="platformPickerSelect" class="adv-select" onchange="handlePlatformPickerChange(this)">
            <% servicesList.forEach(function(s) { %>
              <option value="<%= s.id %>"><%= s.name %></option>
            <% }); %>
          </select>
        </div>
        <% } %>

        <label class="trust-box" id="trustedDeviceBox">
          <input type="checkbox" name="trusted" id="trustedCheckbox" value="true" onchange="handleTrustChange(this)">
          <div class="trust-text">
            <span class="trust-title">Trust this device</span>
            <span class="trust-desc">Keep signed in permanently until manually revoked.</span>
          </div>
        </label>

        <!-- Advanced Settings: Custom Expiration & Service Permissions -->
        <details class="advanced-box" id="advancedBox">
          <summary class="advanced-summary">
            <span class="advanced-title">
              <svg style="width: 15px; height: 15px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
              </svg>
              Advanced
            </span>
            <svg class="chevron-icon" style="width: 14px; height: 14px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>

          <div class="advanced-content">
            <!-- 1. Expiration Time -->
            <div class="adv-group" id="expirationGroup">
              <div class="adv-label-row">
                <label class="adv-label" for="sessionTtl">Expiration Time</label>
                <span id="ttlTrustBadge" class="ttl-trust-badge" style="display: none;">Permanent (Trusted)</span>
              </div>
              <select name="sessionTtl" id="sessionTtl" class="adv-select" onchange="handleTtlChange(this)">
                <option value="1">1 hour</option>
                <option value="8">8 hours</option>
                <option value="24">24 hours (1 day)</option>
                <option value="72" selected>72 hours (3 days - default)</option>
                <option value="168">7 days (1 week)</option>
                <option value="720">30 days (1 month)</option>
                <option value="custom">Custom hours...</option>
              </select>
              <div id="customTtlWrap" style="display: none; margin-top: 0.5rem;">
                <input type="number" name="customTtlHours" id="customTtlHours" class="adv-input" min="1" max="87600" placeholder="Enter hours (e.g. 12)">
              </div>
              <div id="ttlTrustNotice" class="ttl-trust-notice" style="display: none;">
                Trusted devices never expire automatically. Expiration time cannot be changed while trusted.
              </div>
            </div>

            <!-- 2. Services Access Checklist -->
            <div class="adv-group" style="margin-top: 1rem;">
              <div class="adv-label-row">
                <label class="adv-label">Service Access</label>
                <div class="services-header-actions">
                  <% if (targetService) { %>
                    <button type="button" class="btn-toggle-service" onclick="selectOnlyTargetService('<%= targetService.id %>')">Only <%= targetService.name %></button>
                  <% } %>
                  <button type="button" class="btn-toggle-all" onclick="toggleAllServices()">Toggle All</button>
                </div>
              </div>
              <div class="adv-desc">Customize individual service permissions:</div>
              <div class="services-checklist">
                <% servicesList.forEach(function(svc) { 
                     const isTarget = targetServiceId && svc.id.toLowerCase() === targetServiceId.toLowerCase();
                %>
                  <label class="service-check-item <%= isTarget ? 'service-check-target' : '' %>">
                    <input type="checkbox" name="services" value="<%= svc.id %>" checked class="service-checkbox" data-service-id="<%= svc.id %>" onchange="handleServiceCheckboxChange()">
                    <div class="service-check-info">
                      <div class="service-check-name-row">
                        <span class="service-check-name"><%= svc.name %></span>
                        <% if (isTarget) { %><span class="badge-target-svc">Current</span><% } %>
                      </div>
                      <span class="service-check-sub"><%= svc.subtitle || svc.url %></span>
                    </div>
                  </label>
                <% }); %>
              </div>
            </div>
          </div>
        </details>

        <div id="fidoApprovalError" style="display: none; color: #f87171; font-size: 0.85rem; margin-bottom: 1rem; text-align: center;"></div>

        <div class="btn-group">
          <button type="button" class="btn btn-reject" onclick="closeFidoMonit()">Reject</button>
          <button type="submit" class="btn btn-approve" id="btnApproveFido">Approve</button>
        </div>
      </form>
    </div>
  </div>
  <% } %>

  <script id="auth-config" type="application/json"><%- JSON.stringify({
    redirectTarget: redirectTarget || '',
    serviceId: matchedService ? matchedService.id : '',
    isFromOpenHandle: Boolean(isFromOpenHandle),
    defaultTitle: config.app.name,
    defaultSubtitle: config.app.subtitle
  }) %></script>

  <script>
    const socket = io();
    let currentSessionId = null;
    let timerInterval = null;
    let secondsLeft = 120;

    const authConfigEl = document.getElementById('auth-config');
    const authConfig = authConfigEl ? JSON.parse(authConfigEl.textContent || '{}') : {};
    const redirectTarget = authConfig.redirectTarget || '';
    const serviceId = authConfig.serviceId || '';
    const isFromOpenHandle = Boolean(authConfig.isFromOpenHandle);
    const defaultTitle = authConfig.defaultTitle || '';
    const defaultSubtitle = authConfig.defaultSubtitle || '';

    const qrImage = document.getElementById('qrImage');
    const loadingOverlay = document.getElementById('loadingOverlay');
    const expiredOverlay = document.getElementById('expiredOverlay');
    const statusText = document.getElementById('statusText');
    const mainCard = document.getElementById('mainCard');

    function startTimer(durationMs) {
      clearInterval(timerInterval);
      secondsLeft = Math.floor(durationMs / 1000);
      statusText.innerHTML = 'Awaiting approval (<span id="timerCount">' + secondsLeft + '</span>s)';

      timerInterval = setInterval(() => {
        secondsLeft--;
        const countSpan = document.getElementById('timerCount');
        if (countSpan) {
          countSpan.textContent = secondsLeft;
        }

        if (secondsLeft <= 0) {
          clearInterval(timerInterval);
          onSessionExpired();
        }
      }, 1000);
    }

    function onSessionExpired() {
      expiredOverlay.classList.add('active');
      statusText.textContent = 'Session timed out';
      const pairCodeCard = document.getElementById('pairCodeCard');
      if (pairCodeCard) pairCodeCard.style.opacity = '0.35';
    }

    async function initQrSession() {
      try {
        loadingOverlay.classList.add('active');
        expiredOverlay.classList.remove('active');

        const params = new URLSearchParams();
        if (redirectTarget) params.append('redirect', redirectTarget);
        if (serviceId) params.append('service', serviceId);

        const url = '/auth/init' + (params.toString() ? '?' + params.toString() : '');
        const res = await fetch(url, { cache: 'no-store' });
        if (!res.ok) throw new Error('Failed to fetch session init');
        const data = await res.json();

        currentSessionId = data.loginSessionId;
        qrImage.src = data.qrCode;
        qrImage.style.display = 'block';

        const pairCodeDigits = document.getElementById('pairCodeDigits');
        if (pairCodeDigits && data.pairCodeFormatted) {
          pairCodeDigits.textContent = data.pairCodeFormatted;
        }
        const pairCodeCard = document.getElementById('pairCodeCard');
        if (pairCodeCard) pairCodeCard.style.opacity = '1';

        socket.emit('join-session', currentSessionId);

        loadingOverlay.classList.remove('active');

        startTimer(data.ttlMs || 120000);
      } catch (err) {
        console.error(err);
        statusText.textContent = 'Failed to load QR code';
      }
    }

    socket.on('approved', (data) => {
      clearInterval(timerInterval);

      mainCard.innerHTML = `
        <div class="approved-state">
          <div class="approved-icon">
            <svg style="width: 36px; height: 36px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h2 style="color: #ffffff; font-size: 1.45rem; font-weight: 700; margin-bottom: 0.5rem;">Access Approved</h2>
          <p style="color: #94a3b8; font-size: 0.95rem; margin-bottom: 1.5rem;">Starting session...</p>
          <div class="spinner"></div>
        </div>
      `;

      setTimeout(() => {
        const dest = (data && data.redirect) ? data.redirect : redirectTarget;
        if (data && data.code) {
          window.location.href = '/auth/exchange?code=' + encodeURIComponent(data.code) + (dest ? '&redirect=' + encodeURIComponent(dest) : '');
        } else if (data && data.token) {
          window.location.href = '/auth/exchange?token=' + encodeURIComponent(data.token) + (dest ? '&redirect=' + encodeURIComponent(dest) : '');
        } else {
          window.location.href = dest || '/';
        }
      }, 700);
    });

    socket.on('rejected', (data) => {
      clearInterval(timerInterval);
      statusText.innerHTML = '<span style="color: #ef4444; font-weight: 600;">Request Rejected by Approver</span>';
      setTimeout(() => {
        initQrSession();
      }, 2500);
    });

    socket.on('connect', () => {
      if (currentSessionId) {
        socket.emit('join-session', currentSessionId);
      }
    });

    function revealQrLogin() {
      const monit = document.getElementById('openHandleMonit');
      const qrSection = document.getElementById('qrAuthSection');
      const serviceBadge = document.getElementById('serviceBadge');
      const pageTitle = document.getElementById('pageTitle');
      const pageSubtitle = document.getElementById('pageSubtitle');
      if (monit) monit.style.display = 'none';
      if (qrSection) {
        qrSection.style.display = 'block';
      }
      if (serviceBadge) {
        serviceBadge.style.display = 'block';
      }
      if (pageTitle) {
        pageTitle.textContent = defaultTitle;
      }
      if (pageSubtitle) {
        pageSubtitle.style.display = 'block';
        pageSubtitle.textContent = defaultSubtitle;
      }
      try {
        history.replaceState(null, '', window.location.pathname + window.location.search + '#auth');
      } catch {}
      initQrSession();
    }

    function handleGoBack(event, fallbackUrl) {
      event.preventDefault();
      if (fallbackUrl) {
        window.location.href = fallbackUrl;
      } else if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/';
      }
    }

    function base64UrlToUint8Array(base64url) {
      const padding = '='.repeat((4 - (base64url.length % 4)) % 4);
      const base64 = (base64url + padding).replace(/-/g, '+').replace(/_/g, '/');
      const rawData = window.atob(base64);
      const outputArray = new Uint8Array(rawData.length);
      for (let i = 0; i < rawData.length; ++i) {
        outputArray[i] = rawData.charCodeAt(i);
      }
      return outputArray;
    }

    function arrayBufferToBase64Url(buffer) {
      const bytes = new Uint8Array(buffer);
      let binary = '';
      for (let i = 0; i < bytes.byteLength; i++) {
        binary += String.fromCharCode(bytes[i]);
      }
      return window.btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    let storedAssertionJSON = null;
    let storedChallengeId = null;

    function syncToggleBoxStyle(checkbox) {
      if (!checkbox) return;
      var box = checkbox.closest('.trust-box');
      if (box) {
        if (checkbox.checked) {
          box.classList.add('is-checked');
        } else {
          box.classList.remove('is-checked');
        }
      }
    }

    function handleApproverToggle(toggle) {
      syncToggleBoxStyle(toggle);
      var isApprover = toggle.checked;
      var trustedCb = document.getElementById('trustedCheckbox');
      var onlyToggle = document.getElementById('onlyPlatformToggle');
      var expGroup = document.getElementById('expirationGroup');
      var badge = document.getElementById('ttlTrustBadge');
      var notice = document.getElementById('ttlTrustNotice');

      if (isApprover) {
        if (trustedCb) {
          trustedCb.checked = true;
          trustedCb.disabled = true;
          syncToggleBoxStyle(trustedCb);
        }
        if (onlyToggle) {
          onlyToggle.checked = false;
          onlyToggle.disabled = true;
          syncToggleBoxStyle(onlyToggle);
          var wrap = document.getElementById('platformPickerWrap');
          if (wrap) wrap.style.display = 'none';
        }
        var boxes = document.querySelectorAll('.service-checkbox');
        boxes.forEach(function(b) { b.checked = true; b.disabled = true; });
        if (badge) {
          badge.textContent = 'Approver (Permanent)';
          badge.style.display = 'inline-block';
        }
        if (notice) {
          notice.textContent = 'Approver sessions have full permanent access to all services.';
          notice.style.display = 'block';
        }
        if (expGroup) expGroup.classList.add('adv-group-disabled');
      } else {
        if (trustedCb) {
          trustedCb.checked = false;
          trustedCb.disabled = false;
          syncToggleBoxStyle(trustedCb);
        }
        if (onlyToggle) {
          onlyToggle.disabled = false;
          syncToggleBoxStyle(onlyToggle);
        }
        var boxes = document.querySelectorAll('.service-checkbox');
        boxes.forEach(function(b) { b.disabled = false; });
        if (badge) {
          badge.textContent = 'Permanent (Trusted)';
          badge.style.display = 'none';
        }
        if (notice) {
          notice.textContent = 'Trusted devices never expire automatically. Expiration time cannot be changed while trusted.';
          notice.style.display = 'none';
        }
        if (expGroup) expGroup.classList.remove('adv-group-disabled');
        handleTrustChange(trustedCb);
      }
    }

    function handleTrustChange(checkbox) {
      if (!checkbox) return;
      syncToggleBoxStyle(checkbox);
      var isTrusted = checkbox.checked;
      var sel = document.getElementById('sessionTtl');
      var customInp = document.getElementById('customTtlHours');
      var badge = document.getElementById('ttlTrustBadge');
      var notice = document.getElementById('ttlTrustNotice');
      var expGroup = document.getElementById('expirationGroup');

      if (sel) {
        sel.disabled = isTrusted;
      }
      if (customInp) {
        customInp.disabled = isTrusted;
      }
      if (badge) {
        badge.textContent = 'Permanent (Trusted)';
        badge.style.display = isTrusted ? 'inline-block' : 'none';
      }
      if (notice) {
        notice.textContent = 'Trusted devices never expire automatically. Expiration time cannot be changed while trusted.';
        notice.style.display = isTrusted ? 'block' : 'none';
      }
      if (expGroup) {
        if (isTrusted) {
          expGroup.classList.add('adv-group-disabled');
        } else {
          expGroup.classList.remove('adv-group-disabled');
        }
      }
    }

    function handleTtlChange(sel) {
      var wrap = document.getElementById('customTtlWrap');
      if (!wrap) return;
      if (sel.value === 'custom') {
        wrap.style.display = 'block';
        var inp = document.getElementById('customTtlHours');
        if (inp) inp.focus();
      } else {
        wrap.style.display = 'none';
      }
    }

    function handleOnlyPlatformToggle(toggle, targetId) {
      syncToggleBoxStyle(toggle);
      var boxes = document.querySelectorAll('.service-checkbox');
      if (toggle.checked) {
        boxes.forEach(function(b) {
          b.checked = (b.value.toLowerCase() === targetId.toLowerCase());
        });
      } else {
        boxes.forEach(function(b) {
          b.checked = true;
        });
      }
    }

    function handleGenericPlatformToggle(toggle) {
      syncToggleBoxStyle(toggle);
      var wrap = document.getElementById('platformPickerWrap');
      var sel = document.getElementById('platformPickerSelect');
      var boxes = document.querySelectorAll('.service-checkbox');

      if (toggle.checked) {
        if (wrap) wrap.style.display = 'block';
        var selectedId = sel ? sel.value : (boxes[0] ? boxes[0].value : '');
        boxes.forEach(function(b) {
          b.checked = (b.value.toLowerCase() === selectedId.toLowerCase());
        });
      } else {
        if (wrap) wrap.style.display = 'none';
        boxes.forEach(function(b) {
          b.checked = true;
        });
      }
    }

    function handlePlatformPickerChange(sel) {
      var toggle = document.getElementById('onlyPlatformToggle');
      if (!toggle || !toggle.checked) return;
      var selectedId = sel.value;
      var boxes = document.querySelectorAll('.service-checkbox');
      boxes.forEach(function(b) {
        b.checked = (b.value.toLowerCase() === selectedId.toLowerCase());
      });
    }

    function selectOnlyTargetService(targetId) {
      var toggle = document.getElementById('onlyPlatformToggle');
      if (toggle) {
        toggle.checked = true;
        syncToggleBoxStyle(toggle);
        handleOnlyPlatformToggle(toggle, targetId);
      } else {
        var boxes = document.querySelectorAll('.service-checkbox');
        boxes.forEach(function(b) {
          b.checked = (b.value.toLowerCase() === targetId.toLowerCase());
        });
      }
    }

    function handleServiceCheckboxChange() {
      updatePlatformToggleState();
    }

    function updatePlatformToggleState() {
      var toggle = document.getElementById('onlyPlatformToggle');
      if (!toggle) return;
      var targetId = toggle.getAttribute('data-target-id');
      var boxes = document.querySelectorAll('.service-checkbox');

      if (targetId) {
        var targetFound = false;
        var anyOtherChecked = false;

        boxes.forEach(function(b) {
          if (b.value.toLowerCase() === targetId.toLowerCase()) {
            if (b.checked) targetFound = true;
          } else {
            if (b.checked) anyOtherChecked = true;
          }
        });

        toggle.checked = targetFound && !anyOtherChecked;
      } else {
        var wrap = document.getElementById('platformPickerWrap');
        var sel = document.getElementById('platformPickerSelect');
        var checkedBoxes = Array.from(boxes).filter(function(b) { return b.checked; });

        if (checkedBoxes.length === 1) {
          toggle.checked = true;
          if (wrap) wrap.style.display = 'block';
          if (sel) sel.value = checkedBoxes[0].value;
        } else {
          toggle.checked = false;
          if (wrap) wrap.style.display = 'none';
        }
      }
      syncToggleBoxStyle(toggle);
    }

    function toggleAllServices() {
      var boxes = document.querySelectorAll('.service-checkbox');
      var allChecked = Array.from(boxes).every(function(b) { return b.checked; });
      boxes.forEach(function(b) { b.checked = !allChecked; });
      updatePlatformToggleState();
    }

    function openFidoMonit() {
      const modal = document.getElementById('fidoAuthModal');
      const errBox = document.getElementById('fidoApprovalError');
      const btn = document.getElementById('btnApproveFido');
      if (errBox) {
        errBox.style.display = 'none';
        errBox.textContent = '';
      }
      if (btn) {
        btn.disabled = false;
        btn.textContent = 'Approve';
        btn.style.background = '';
      }

      document.querySelectorAll('.trust-box input[type="checkbox"]').forEach(function(inp) {
        syncToggleBoxStyle(inp);
      });

      if (modal) modal.style.display = 'flex';
    }

    function closeFidoMonit() {
      const modal = document.getElementById('fidoAuthModal');
      if (modal) modal.style.display = 'none';
      storedAssertionJSON = null;
      storedChallengeId = null;
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeFidoMonit();
      }
    });

    async function startDirectFidoLogin() {
      const btn = document.getElementById('btnFidoDirect');
      const status = document.getElementById('fidoDirectStatus');
      if (status) {
        status.style.display = 'none';
        status.textContent = '';
      }
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = `<span class="spinner" style="width: 15px; height: 15px; border-width: 2px; margin: 0; display: inline-block;"></span><span>Touch key...</span>`;
      }

      try {
        if (!window.PublicKeyCredential) {
          throw new Error('WebAuthn / FIDO2 is not supported in this browser (HTTPS is required).');
        }

        const optRes = await fetch('/auth/approver/webauthn/login-options');
        if (!optRes.ok) {
          const errData = await optRes.json().catch(() => ({}));
          throw new Error(errData.error || 'Failed to initialize security key challenge.');
        }

        const { challengeId, options } = await optRes.json();
        options.challenge = base64UrlToUint8Array(options.challenge);

        if (Array.isArray(options.allowCredentials)) {
          options.allowCredentials.forEach(cred => {
            cred.id = base64UrlToUint8Array(cred.id);
          });
        }

        if (status) {
          status.textContent = 'Touch your security key or confirm biometric prompt...';
          status.style.color = '#38bdf8';
          status.style.display = 'block';
        }

        const assertion = await navigator.credentials.get({ publicKey: options });

        storedChallengeId = challengeId;
        storedAssertionJSON = {
          id: assertion.id,
          rawId: arrayBufferToBase64Url(assertion.rawId),
          type: assertion.type,
          response: {
            clientDataJSON: arrayBufferToBase64Url(assertion.response.clientDataJSON),
            authenticatorData: arrayBufferToBase64Url(assertion.response.authenticatorData),
            signature: arrayBufferToBase64Url(assertion.response.signature),
            userHandle: assertion.response.userHandle ? arrayBufferToBase64Url(assertion.response.userHandle) : null
          }
        };

        if (status) {
          status.style.display = 'none';
        }
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = `
            <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
            <span>Sign in with Security Key</span>
          `;
        }

        // Show the approval monit NOW, after logging in with security key!
        openFidoMonit();
      } catch (err) {
        console.error(err);
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = `
            <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
            <span>Sign in with Security Key</span>
          `;
        }
        if (status) {
          status.textContent = err.name === 'NotAllowedError'
            ? 'Security key request was cancelled or timed out.'
            : (err.message || 'Authentication failed.');
          status.style.color = '#f87171';
          status.style.display = 'block';
        }
      }
    }

    async function handleFidoApprovalSubmit(event) {
      if (event) event.preventDefault();
      const btn = document.getElementById('btnApproveFido');
      const errBox = document.getElementById('fidoApprovalError');
      if (errBox) {
        errBox.style.display = 'none';
        errBox.textContent = '';
      }

      if (!storedAssertionJSON || !storedChallengeId) {
        if (errBox) {
          errBox.textContent = 'Session challenge expired. Please re-authenticate with your security key.';
          errBox.style.display = 'block';
        }
        return false;
      }

      const approverToggle = document.getElementById('loginAsApproverToggle');
      const loginAsApprover = approverToggle ? approverToggle.checked : false;

      const checkedBoxes = document.querySelectorAll('.service-checkbox:checked');
      if (!loginAsApprover && checkedBoxes.length === 0) {
        if (errBox) {
          errBox.textContent = 'Please select at least one service to grant access.';
          errBox.style.display = 'block';
        }
        return false;
      }

      const customName = document.getElementById('fidoCustomName') ? document.getElementById('fidoCustomName').value : '';
      const trustedCb = document.getElementById('trustedCheckbox');
      const trusted = trustedCb ? trustedCb.checked : false;
      const ttlSelect = document.getElementById('sessionTtl');
      const sessionTtl = ttlSelect ? ttlSelect.value : '72';
      const customTtlHours = document.getElementById('customTtlHours') ? document.getElementById('customTtlHours').value : '';
      const checkedServices = Array.from(checkedBoxes).map(b => b.value);

      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Authorizing...';
      }

      try {
        const verifyRes = await fetch('/auth/approver/webauthn/login-verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            challengeId: storedChallengeId,
            returnTo: redirectTarget,
            response: storedAssertionJSON,
            loginAsApprover,
            sessionType: loginAsApprover ? 'approver' : 'user',
            customName,
            trusted,
            sessionTtl,
            customTtlHours,
            services: checkedServices,
            loginSessionId: currentSessionId
          })
        });

        const verifyData = await verifyRes.json();
        if (!verifyRes.ok || !verifyData.success) {
          throw new Error(verifyData.error || 'Authentication failed.');
        }

        if (btn) {
          btn.textContent = 'Authorized!';
          btn.style.background = '#10b981';
        }

        setTimeout(() => {
          window.location.href = verifyData.redirect || redirectTarget || '/';
        }, 300);
      } catch (err) {
        console.error(err);
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Approve';
        }
        if (errBox) {
          errBox.textContent = err.message || 'Failed to complete authorization.';
          errBox.style.display = 'block';
        }
      }
      return false;
    }

    if (isFromOpenHandle && window.location.hash !== '#auth') {
      // Monit is active: do not show QR code or start session timer right away
    } else {
      if (isFromOpenHandle && window.location.hash === '#auth') {
        const monit = document.getElementById('openHandleMonit');
        const qrSection = document.getElementById('qrAuthSection');
        const serviceBadge = document.getElementById('serviceBadge');
        const pageTitle = document.getElementById('pageTitle');
        const pageSubtitle = document.getElementById('pageSubtitle');
        if (monit) monit.style.display = 'none';
        if (qrSection) qrSection.style.display = 'block';
        if (serviceBadge) serviceBadge.style.display = 'block';
        if (pageTitle) pageTitle.textContent = defaultTitle;
        if (pageSubtitle) {
          pageSubtitle.style.display = 'block';
          pageSubtitle.textContent = defaultSubtitle;
        }
      }
      initQrSession();
    }
  </script>
  <%- include('partials/pwa-sw') %>
</body>
</html>
