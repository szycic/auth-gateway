<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { extraCss: '/css/sessions.css' }) %>
  <title>Active Sessions - <%= config.app.name %></title>
  <script src="/auth/assets/jsqr.js"></script>
  <script src="/socket.io/socket.io.js"></script>
</head>
<body>
  <div class="ambient-glow"></div>
  <%
    const pad = (n) => String(n).padStart(2, '0');
  %>
  <div class="container">
    <div class="top-bar">
      <h1>Session Gateway</h1>
      <div style="display: flex; gap: 0.5rem; align-items: center;">
        <a href="/" class="btn-logout" style="color: #38bdf8; border-color: rgba(56, 189, 248, 0.3);">Portal</a>
        <a href="/auth/approver/logout" class="btn-logout">Sign Out</a>
      </div>
    </div>

    <% if (notice) { %>
      <div class="notice" id="dashboard-notice"><%= notice %></div>
    <% } else { %>
      <div class="notice" id="dashboard-notice" style="display: none;"></div>
    <% } %>

    <!-- Dual Action Header: Scan QR & Enter Code -->
    <div class="action-buttons-grid">
      <button type="button" class="btn-action-hero btn-scan-qr" onclick="openScanner()">
        <svg style="width: 20px; height: 20px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
        </svg>
        <span>Scan QR Code</span>
      </button>
      <button type="button" class="btn-action-hero btn-enter-code" onclick="openPairCodeModal()">
        <svg style="width: 20px; height: 20px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
        </svg>
        <span>Enter Code</span>
      </button>
    </div>

    <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.85rem; color: #ffffff;">Active Authorized Sessions</h2>

    <div id="sessions-container">
      <% if (activeSessionsList && activeSessionsList.length > 0) { %>
        <div class="session-list">
          <% activeSessionsList.forEach(function(s) { 
               const elapsedMinutes = Math.floor(Math.max(0, Date.now() - (s.createdAt || Date.now())) / 60000);
               let timeLabel = 'just now';
               if (elapsedMinutes >= 60 * 24) {
                 timeLabel = Math.floor(elapsedMinutes / (60 * 24)) + 'd ago';
               } else if (elapsedMinutes >= 60) {
                 timeLabel = Math.floor(elapsedMinutes / 60) + 'h ago';
               } else if (elapsedMinutes >= 1) {
                 timeLabel = elapsedMinutes + 'm ago';
               }

               let expiresLabel = 'Never';
               if (s.expiresAt) {
                 const expDate = new Date(s.expiresAt);
                 if (!isNaN(expDate.getTime())) {
                   expiresLabel = pad(expDate.getDate()) + '.' + pad(expDate.getMonth() + 1) + '.' + expDate.getFullYear() + ' ' + pad(expDate.getHours()) + ':' + pad(expDate.getMinutes());
                 }
               }
               const deviceName = s.friendlyDevice || 'Desktop Browser';
          %>
            <% 
              const isCustomAccess = Array.isArray(s.allowedServices) && s.allowedServices.length > 0 && !s.allowedServices.includes('*');
              let initialSvcNames = 'All Services';
              let initialAllowed = ['*'];
              if (isCustomAccess) {
                initialSvcNames = s.allowedServices.map(function(id) {
                  const found = (config.services || []).find(svc => (svc.id || '').toLowerCase() === id.toLowerCase());
                  return found ? found.name : id;
                }).join(', ');
                initialAllowed = s.allowedServices;
              }
            %>
            <div class="session-card" id="session-card-<%= s.id %>" data-session-id="<%= s.id %>" data-device-name="<%= deviceName %>" data-allowed-services="<%- JSON.stringify(initialAllowed || []).replace(/"/g, '&quot;') %>">
              <div class="session-info">
                <div class="session-header" id="header-<%= s.id %>">
                  <span class="session-name" id="name-<%= s.id %>"><%= deviceName %></span>
                  <button type="button" class="btn-rename-trigger" onclick="openRename('<%= s.id %>')" title="Rename device" aria-label="Rename device">
                    <svg style="width: 13px; height: 13px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                  </button>
                  <button type="button" class="btn-perm-trigger" onclick="openPermissionsModalForCard('<%= s.id %>')" title="Edit service permissions" aria-label="Edit service permissions">
                    <svg style="width: 13px; height: 13px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                    </svg>
                  </button>
                  <% if (s.isTrusted) { %>
                    <span class="badge-trusted">
                      <svg style="width: 12px; height: 12px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                      </svg>
                      Trusted
                    </span>
                  <% } else { %>
                    <span class="badge-temp">Temporary</span>
                  <% } %>
                </div>
                <form method="POST" action="/auth/sessions/rename" class="rename-form" id="rename-form-<%= s.id %>" style="display: none;">
                  <input type="hidden" name="sessionId" value="<%= s.id %>">
                  <input type="text" name="name" class="rename-input" id="rename-input-<%= s.id %>" value="<%= deviceName %>" maxlength="40" required placeholder="Device name">
                  <button type="submit" class="btn-rename-save">Save</button>
                  <button type="button" class="btn-rename-cancel" onclick="closeRename('<%= s.id %>')">Cancel</button>
                </form>
                <div class="session-sub">
                  <div><%= s.ip %> &bull; <span class="session-started" data-created="<%= s.createdAt || '' %>">Started <%= timeLabel %></span></div>
                  <div class="session-expiry" data-expires="<%= s.expiresAt || '' %>">Expires <%= expiresLabel %></div>
                  <div class="session-services-row" id="services-row-<%= s.id %>">
                    <span style="color: #94a3b8;">Access:</span>
                    <span class="session-services-label" id="services-label-<%= s.id %>" style="color: #38bdf8; font-weight: 500;"><%= initialSvcNames %></span>
                  </div>
                </div>
              </div>
              <form method="POST" action="/auth/sessions/revoke" onsubmit="handleRevoke(event, '<%= s.id %>')">
                <input type="hidden" name="sessionId" value="<%= s.id %>">
                <button type="submit" class="btn-revoke" id="btn-revoke-<%= s.id %>" title="Revoke access">Revoke</button>
              </form>
            </div>
          <% }); %>
        </div>
        <form method="POST" action="/auth/sessions/revoke" class="revoke-all-form" onsubmit="handleRevokeAll(event)">
          <input type="hidden" name="all" value="true">
          <button type="submit" class="btn-revoke-all" id="btn-revoke-all">
            Revoke All Active Sessions
          </button>
        </form>
      <% } else { %>
        <div class="empty-state">
          <p>No active desktop sessions.</p>
          <p style="font-size: 0.8rem; margin-top: 0.4rem;">Tap "Scan Desktop QR Code" above to authorize a new computer.</p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- In-App Scanner Modal -->
  <div class="scanner-overlay" id="scannerModal">
    <div class="scanner-header">
      <div class="scanner-title">Scan QR Code</div>
      <button class="btn-close-scanner" onclick="closeScanner()" aria-label="Close">
        <svg style="width: 20px; height: 20px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="scanner-viewfinder">
      <video id="scannerVideo" class="scanner-video" playsinline muted autoplay></video>
      <div class="scanner-corners"></div>
      <canvas id="scannerCanvas" style="display: none;"></canvas>
    </div>

    <p class="scanner-tip">Point your phone camera directly at the QR code on the computer screen.</p>
    <div class="scanner-status" id="scannerStatus">Starting camera...</div>
  </div>

  <!-- In-App 8-Digit Pairing Code Modal -->
  <div class="pair-modal-overlay" id="pairCodeModal" onclick="if(event.target===this)closePairCodeModal()">
    <div class="pair-modal-card">
      <div class="pair-modal-header">
        <div class="pair-modal-title">Enter 8-Digit Code</div>
        <button type="button" class="btn-close-scanner" onclick="closePairCodeModal()" aria-label="Close">
          <svg style="width: 20px; height: 20px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <p class="pair-modal-desc">Type the 8 digits shown on the computer screen to authorize access.</p>

      <form id="pairCodeForm" onsubmit="handlePairCodeSubmit(event)">
        <div class="pair-boxes-wrap">
          <input
            type="text"
            id="pairBox1"
            class="pair-box"
            inputmode="numeric"
            pattern="[0-9]*"
            maxlength="4"
            placeholder="••••"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            oninput="handleBoxInput(this, 'pairBox2')"
            onkeydown="handleBoxKeydown(this, event, null, 'pairBox2')"
            onpaste="handleBoxPaste(event)"
          />
          <span class="pair-box-sep">—</span>
          <input
            type="text"
            id="pairBox2"
            class="pair-box"
            inputmode="numeric"
            pattern="[0-9]*"
            maxlength="4"
            placeholder="••••"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            oninput="handleBoxInput(this, null)"
            onkeydown="handleBoxKeydown(this, event, 'pairBox1', null)"
            onpaste="handleBoxPaste(event)"
          />
        </div>
        <div class="pair-modal-error" id="pairCodeError" style="display: none;"></div>

        <button type="submit" class="btn-pair-submit" id="btnPairSubmit">
          Authorize Device
        </button>
      </form>
    </div>
  </div>

  <!-- In-App Permissions Management Modal -->
  <div class="pair-modal-overlay" id="permissionsModal" style="display: none;" onclick="if(event.target===this)closePermissionsModal()">
    <div class="pair-modal-card permissions-modal-card">
      <div class="pair-modal-header">
        <div>
          <div class="pair-modal-title">Edit Permissions</div>
          <div class="permissions-modal-device" id="modalDeviceName">Desktop Browser</div>
        </div>
        <button type="button" class="btn-close-scanner" onclick="closePermissionsModal()" aria-label="Close">
          <svg style="width: 20px; height: 20px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <p class="pair-modal-desc" style="margin-bottom: 0.5rem;">Select which services this session is permitted to access.</p>

      <div class="permissions-header-actions">
        <button type="button" class="btn-toggle-all" id="btnToggleAllServices" onclick="toggleAllModalServices()">Select All</button>
      </div>

      <form id="permissionsForm" onsubmit="handlePermissionsSubmit(event)">
        <input type="hidden" id="permSessionId" name="sessionId" value="">

        <div class="modal-services-checklist" id="modalServicesChecklist">
          <% 
            const activeSvcs = (config.getActiveServices ? config.getActiveServices() : config.services) || [];
            activeSvcs.forEach(function(svc) { 
          %>
            <label class="modal-service-check-item" for="perm-svc-<%= svc.id %>">
              <input 
                type="checkbox" 
                class="modal-service-checkbox" 
                id="perm-svc-<%= svc.id %>" 
                name="services" 
                value="<%= svc.id %>"
                onchange="onModalServiceChange()"
              />
              <div class="modal-service-check-info">
                <span class="modal-service-check-name"><%= svc.name %></span>
                <span class="modal-service-check-sub"><%= svc.description || svc.id %></span>
              </div>
            </label>
          <% }); %>
        </div>

        <div class="pair-modal-error" id="permissionsModalError" style="display: none;"></div>

        <div class="permissions-modal-footer">
          <button type="button" class="btn-modal-cancel" onclick="closePermissionsModal()">Cancel</button>
          <button type="submit" class="btn-pair-submit" id="btnSavePermissions" style="flex: 1; margin-top: 0;">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <script id="known-services-data" type="application/json"><%- JSON.stringify(((config.getActiveServices ? config.getActiveServices() : config.services) || []).map(s => ({ id: (s.id || '').toLowerCase(), name: s.name }))).replace(/</g, '\\u003c') %></script>
  <script>
    function openRename(id) {
      const form = document.getElementById('rename-form-' + id);
      const header = document.getElementById('header-' + id);
      if (!form) return;
      form.style.display = 'flex';
      if (header) header.style.display = 'none';
      const input = document.getElementById('rename-input-' + id);
      if (input) {
        input.focus();
        input.select();
      }
    }

    function closeRename(id) {
      const form = document.getElementById('rename-form-' + id);
      const header = document.getElementById('header-' + id);
      if (!form) return;
      form.style.display = 'none';
      if (header) header.style.display = 'flex';
    }

    function padZero(n) {
      return String(n).padStart(2, '0');
    }

    function updateSessionTimestamps() {
      document.querySelectorAll('.session-expiry[data-expires]').forEach(function(el) {
        const raw = el.getAttribute('data-expires');
        if (!raw) return;
        const ts = Number(raw);
        if (!ts || isNaN(ts)) return;
        const d = new Date(ts);
        if (isNaN(d.getTime())) return;
        const formatted = padZero(d.getDate()) + '.' +
          padZero(d.getMonth() + 1) + '.' +
          d.getFullYear() + ' ' +
          padZero(d.getHours()) + ':' +
          padZero(d.getMinutes());
        el.textContent = 'Expires ' + formatted;
      });

      document.querySelectorAll('.session-started[data-created]').forEach(function(el) {
        const raw = el.getAttribute('data-created');
        if (!raw) return;
        const ts = Number(raw);
        if (!ts || isNaN(ts)) return;
        const elapsedMinutes = Math.floor(Math.max(0, Date.now() - ts) / 60000);
        let label = 'just now';
        if (elapsedMinutes >= 60 * 24) {
          label = Math.floor(elapsedMinutes / (60 * 24)) + 'd ago';
        } else if (elapsedMinutes >= 60) {
          label = Math.floor(elapsedMinutes / 60) + 'h ago';
        } else if (elapsedMinutes >= 1) {
          label = elapsedMinutes + 'm ago';
        }
        el.textContent = 'Started ' + label;
      });
    }

    updateSessionTimestamps();
    setInterval(updateSessionTimestamps, 60000);

    const knownServicesEl = document.getElementById('known-services-data');
    const KNOWN_SERVICES = knownServicesEl ? JSON.parse(knownServicesEl.textContent || '[]') : [];

    function getAccessLabel(allowedServices) {
      if (!allowedServices || (Array.isArray(allowedServices) && (allowedServices.includes('*') || allowedServices.length === 0))) {
        return 'All Services';
      }
      return allowedServices.map(function(id) {
        const found = KNOWN_SERVICES.find(s => s.id === (id || '').toLowerCase());
        return found ? found.name : id;
      }).join(', ');
    }

    function updateCardPermissions(sessionId, allowedServices) {
      const card = document.getElementById('session-card-' + sessionId);
      if (!card) return;
      const normalized = (!allowedServices || allowedServices.includes('*')) ? ['*'] : allowedServices;
      card.dataset.allowedServices = JSON.stringify(normalized);
      const labelEl = document.getElementById('services-label-' + sessionId);
      if (labelEl) {
        labelEl.textContent = getAccessLabel(allowedServices);
      }
    }

    function openPermissionsModalForCard(sessionId) {
      const card = document.getElementById('session-card-' + sessionId);
      if (!card) return;
      const deviceName = card.dataset.deviceName || 'Desktop Browser';
      let allowed = ['*'];
      try {
        if (card.dataset.allowedServices) {
          allowed = JSON.parse(card.dataset.allowedServices);
        }
      } catch (e) {}
      openPermissionsModal(sessionId, deviceName, allowed);
    }

    function openPermissionsModal(sessionId, deviceName, allowedServices) {
      const modal = document.getElementById('permissionsModal');
      const idInput = document.getElementById('permSessionId');
      const devNameEl = document.getElementById('modalDeviceName');
      const errEl = document.getElementById('permissionsModalError');
      if (!modal || !idInput) return;

      idInput.value = sessionId;
      if (devNameEl) devNameEl.textContent = deviceName;
      if (errEl) {
        errEl.style.display = 'none';
        errEl.textContent = '';
      }

      const isAll = !allowedServices || !Array.isArray(allowedServices) || allowedServices.includes('*') || allowedServices.length === 0;
      const lowerAllowed = Array.isArray(allowedServices) ? allowedServices.map(s => String(s).toLowerCase()) : [];

      const checkboxes = document.querySelectorAll('.modal-service-checkbox');
      checkboxes.forEach(function(cb) {
        if (isAll) {
          cb.checked = true;
        } else {
          cb.checked = lowerAllowed.includes(cb.value.toLowerCase());
        }
      });

      updateToggleAllButtonText();
      modal.style.display = 'flex';
    }

    function closePermissionsModal() {
      const modal = document.getElementById('permissionsModal');
      if (modal) modal.style.display = 'none';
    }

    function updateToggleAllButtonText() {
      const btn = document.getElementById('btnToggleAllServices');
      if (!btn) return;
      const checkboxes = Array.from(document.querySelectorAll('.modal-service-checkbox'));
      const allChecked = checkboxes.length > 0 && checkboxes.every(cb => cb.checked);
      btn.textContent = allChecked ? 'Deselect All' : 'Select All';
    }

    function onModalServiceChange() {
      updateToggleAllButtonText();
      const errEl = document.getElementById('permissionsModalError');
      if (errEl) errEl.style.display = 'none';
    }

    function toggleAllModalServices() {
      const checkboxes = Array.from(document.querySelectorAll('.modal-service-checkbox'));
      const allChecked = checkboxes.length > 0 && checkboxes.every(cb => cb.checked);
      checkboxes.forEach(function(cb) {
        cb.checked = !allChecked;
      });
      updateToggleAllButtonText();
      const errEl = document.getElementById('permissionsModalError');
      if (errEl) errEl.style.display = 'none';
    }

    async function handlePermissionsSubmit(e) {
      if (e) e.preventDefault();
      const idInput = document.getElementById('permSessionId');
      const btn = document.getElementById('btnSavePermissions');
      const errEl = document.getElementById('permissionsModalError');
      if (!idInput) return;
      const sessionId = idInput.value;

      const checked = Array.from(document.querySelectorAll('.modal-service-checkbox:checked')).map(cb => cb.value);
      if (checked.length === 0) {
        if (errEl) {
          errEl.textContent = 'Please select at least one service.';
          errEl.style.display = 'block';
        }
        return;
      }

      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Saving...';
      }

      try {
        const res = await fetch('/auth/sessions/permissions', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          credentials: 'include',
          body: JSON.stringify({
            sessionId: sessionId,
            services: checked,
          }),
        });

        const data = await res.json().catch(() => ({}));
        if (!res.ok || data.error) {
          throw new Error(data.error || 'Failed to update permissions.');
        }

        updateCardPermissions(data.sessionId || sessionId, data.allowedServices);
        showNotice(data.message || 'Permissions updated successfully.');
        closePermissionsModal();
      } catch (err) {
        if (errEl) {
          errEl.textContent = err.message || 'Failed to update permissions.';
          errEl.style.display = 'block';
        }
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Save Changes';
        }
      }
    }

    const socket = typeof io !== 'undefined' ? io() : null;
    if (socket) {
      socket.on('session-revoked', function(data) {
        if (data && data.all) {
          removeAllSessionCards('All sessions revoked.');
        } else if (data && data.sessionId) {
          removeSessionCard(data.sessionId, 'Session revoked.');
        }
      });
      socket.on('session-permissions-updated', function(data) {
        if (data && data.sessionId) {
          updateCardPermissions(data.sessionId, data.allowedServices);
        }
      });
    }

    function showNotice(msg) {
      let noticeEl = document.getElementById('dashboard-notice');
      if (noticeEl) {
        noticeEl.textContent = msg;
        noticeEl.style.display = 'block';
      }
    }

    function removeSessionCard(sessionId, noticeMsg) {
      const card = document.getElementById('session-card-' + sessionId);
      if (card) {
        card.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
        card.style.opacity = '0';
        card.style.transform = 'scale(0.95)';
        setTimeout(() => {
          card.remove();
          const list = document.querySelector('.session-list');
          if (list && list.children.length === 0) {
            showEmptyState();
          }
        }, 250);
      }
      if (noticeMsg) showNotice(noticeMsg);
    }

    function removeAllSessionCards(noticeMsg) {
      const list = document.querySelector('.session-list');
      if (list) {
        list.style.transition = 'opacity 0.25s ease';
        list.style.opacity = '0';
        setTimeout(() => {
          showEmptyState();
        }, 250);
      }
      if (noticeMsg) showNotice(noticeMsg);
    }

    function showEmptyState() {
      const container = document.getElementById('sessions-container');
      if (container) {
        container.innerHTML = '<div class="empty-state">' +
          '<p>No active desktop sessions.</p>' +
          '<p style="font-size: 0.8rem; margin-top: 0.4rem;">Tap "Scan Desktop QR Code" above to authorize a new computer.</p>' +
          '</div>';
      }
    }

    async function handleRevoke(e, sessionId) {
      if (e) e.preventDefault();
      const btn = document.getElementById('btn-revoke-' + sessionId);
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Revoking...';
      }
      try {
        const res = await fetch('/auth/sessions/revoke', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ sessionId })
        });
        if (!res.ok) {
          const errData = await res.json().catch(function() { return {}; });
          throw new Error(errData.error || ('Revocation failed (' + res.status + ')'));
        }
        const data = await res.json();
        removeSessionCard(sessionId, data.message || 'Session revoked.');
      } catch (err) {
        console.error(err);
        alert('Could not revoke session: ' + err.message);
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Revoke';
        }
      }
    }

    async function handleRevokeAll(e) {
      if (e) e.preventDefault();
      if (!confirm('Revoke all authenticated desktop sessions?')) return;
      const btn = document.getElementById('btn-revoke-all');
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Revoking All...';
      }
      try {
        const res = await fetch('/auth/sessions/revoke', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ all: true })
        });
        if (!res.ok) {
          const errData = await res.json().catch(function() { return {}; });
          throw new Error(errData.error || ('Revocation failed (' + res.status + ')'));
        }
        const data = await res.json();
        removeAllSessionCards(data.message || 'All sessions revoked.');
      } catch (err) {
        console.error(err);
        alert('Could not revoke all sessions: ' + err.message);
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Revoke All Active Sessions';
        }
      }
    }

    let scannerStream = null;
    let scanAnimFrame = null;
    const scannerModal = document.getElementById('scannerModal');
    const scannerVideo = document.getElementById('scannerVideo');
    const scannerCanvas = document.getElementById('scannerCanvas');
    const scannerStatus = document.getElementById('scannerStatus');
    const canvasCtx = scannerCanvas.getContext('2d');

    async function openScanner() {
      scannerModal.classList.add('active');
      scannerStatus.textContent = 'Initializing camera...';

      try {
        scannerStream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: { ideal: 'environment' } }
        });
        scannerVideo.srcObject = scannerStream;
        await scannerVideo.play();
        scannerStatus.textContent = 'Scanning for QR code...';
        scanFrame();
      } catch (err) {
        console.error('Camera error:', err);
        scannerStatus.innerHTML = '<span style="color: #ef4444;">Camera permission denied or camera unavailable.</span>';
      }
    }

    function closeScanner() {
      if (scannerStream) {
        scannerStream.getTracks().forEach(t => t.stop());
        scannerStream = null;
      }
      if (scanAnimFrame) {
        cancelAnimationFrame(scanAnimFrame);
        scanAnimFrame = null;
      }
      scannerModal.classList.remove('active');
    }

    function scanFrame() {
      if (!scannerModal.classList.contains('active')) return;

      if (scannerVideo.readyState === scannerVideo.HAVE_ENOUGH_DATA) {
        scannerCanvas.width = scannerVideo.videoWidth;
        scannerCanvas.height = scannerVideo.videoHeight;
        canvasCtx.drawImage(scannerVideo, 0, 0, scannerCanvas.width, scannerCanvas.height);

        const imgData = canvasCtx.getImageData(0, 0, scannerCanvas.width, scannerCanvas.height);

        if (typeof jsQR !== 'undefined') {
          const code = jsQR(imgData.data, imgData.width, imgData.height, {
            inversionAttempts: 'dontInvert',
          });

          if (code && code.data) {
            handleDecodedQr(code.data);
            return;
          }
        }
      }

      scanAnimFrame = requestAnimationFrame(scanFrame);
    }

    function handleDecodedQr(url) {
      if (url.includes('/auth/approve')) {
        scannerStatus.innerHTML = '<span style="color: #10b981; font-weight: 700;">QR Detected! Redirecting to authorization...</span>';
        if (navigator.vibrate) navigator.vibrate([50, 50, 50]);
        setTimeout(() => {
          window.location.href = url;
        }, 300);
      } else {
        scannerStatus.textContent = 'Non-authorization QR code detected.';
        scanAnimFrame = requestAnimationFrame(scanFrame);
      }
    }

    const actionParam = new URLSearchParams(window.location.search).get('action');
    if (actionParam === 'scan') {
      window.addEventListener('DOMContentLoaded', () => {
        setTimeout(openScanner, 250);
      });
    } else if (actionParam === 'pin' || actionParam === 'code') {
      window.addEventListener('DOMContentLoaded', () => {
        setTimeout(openPairCodeModal, 250);
      });
    }

    function openPairCodeModal() {
      const modal = document.getElementById('pairCodeModal');
      const b1 = document.getElementById('pairBox1');
      const b2 = document.getElementById('pairBox2');
      const errEl = document.getElementById('pairCodeError');
      const btn = document.getElementById('btnPairSubmit');
      if (errEl) errEl.style.display = 'none';
      if (btn) {
        btn.disabled = false;
        btn.textContent = 'Authorize Device';
      }
      if (b1) { b1.value = ''; b1.disabled = false; }
      if (b2) { b2.value = ''; b2.disabled = false; }
      if (modal) modal.classList.add('active');
      setTimeout(() => {
        if (b1) b1.focus();
      }, 100);
    }

    function closePairCodeModal() {
      const modal = document.getElementById('pairCodeModal');
      if (modal) modal.classList.remove('active');
    }

    function handleBoxInput(el, nextBoxId) {
      el.value = el.value.replace(/\D/g, '').slice(0, 4);
      const errEl = document.getElementById('pairCodeError');
      if (errEl) errEl.style.display = 'none';

      if (el.value.length === 4 && nextBoxId) {
        const next = document.getElementById(nextBoxId);
        if (next) {
          next.focus();
          next.select();
        }
      }

      checkAndSubmitCode();
    }

    function handleBoxKeydown(el, e, prevBoxId, nextBoxId) {
      if (e.key === 'Escape') {
        closePairCodeModal();
        return;
      }
      if (e.key === 'Backspace' && el.value.length === 0 && prevBoxId) {
        const prev = document.getElementById(prevBoxId);
        if (prev) {
          prev.focus();
          prev.value = prev.value.slice(0, -1);
          e.preventDefault();
        }
      } else if ((e.key === '-' || e.key === ' ') && nextBoxId) {
        e.preventDefault();
        const next = document.getElementById(nextBoxId);
        if (next) next.focus();
      } else if (e.key === 'ArrowRight' && el.selectionStart === el.value.length && nextBoxId) {
        const next = document.getElementById(nextBoxId);
        if (next) next.focus();
      } else if (e.key === 'ArrowLeft' && el.selectionStart === 0 && prevBoxId) {
        const prev = document.getElementById(prevBoxId);
        if (prev) prev.focus();
      }
    }

    function handleBoxPaste(e) {
      e.preventDefault();
      const text = (e.clipboardData || window.clipboardData).getData('text') || '';
      const digits = text.replace(/\D/g, '').slice(0, 8);
      const b1 = document.getElementById('pairBox1');
      const b2 = document.getElementById('pairBox2');
      if (!b1 || !b2) return;

      b1.value = digits.slice(0, 4);
      b2.value = digits.slice(4, 8);

      if (b1.value.length === 4 && b2.value.length < 4) {
        b2.focus();
      } else if (b2.value.length === 4) {
        b2.focus();
      }
      checkAndSubmitCode();
    }

    function checkAndSubmitCode() {
      const b1 = document.getElementById('pairBox1');
      const b2 = document.getElementById('pairBox2');
      if (!b1 || !b2) return;
      const code = (b1.value + b2.value).replace(/\D/g, '');
      if (code.length === 8) {
        verifyPairCode(code);
      }
    }

    async function handlePairCodeSubmit(e) {
      if (e) e.preventDefault();
      const b1 = document.getElementById('pairBox1');
      const b2 = document.getElementById('pairBox2');
      if (!b1 || !b2) return;
      const code = (b1.value + b2.value).replace(/\D/g, '');
      if (code.length !== 8) {
        const errEl = document.getElementById('pairCodeError');
        if (errEl) {
          errEl.textContent = 'Please enter all 8 digits.';
          errEl.style.display = 'block';
        }
        if (b1.value.length < 4) b1.focus();
        else b2.focus();
        return;
      }
      verifyPairCode(code);
    }

    async function verifyPairCode(cleanCode) {
      const btn = document.getElementById('btnPairSubmit');
      const b1 = document.getElementById('pairBox1');
      const b2 = document.getElementById('pairBox2');
      const errEl = document.getElementById('pairCodeError');
      if (errEl) errEl.style.display = 'none';
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Verifying...';
      }
      if (b1) b1.disabled = true;
      if (b2) b2.disabled = true;

      try {
        const res = await fetch('/auth/code/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ code: cleanCode })
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Code verification failed.');
        }
        if (data.redirectUrl) {
          window.location.href = data.redirectUrl;
        }
      } catch (err) {
        if (errEl) {
          errEl.textContent = err.message || 'Invalid or expired code.';
          errEl.style.display = 'block';
        }
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Authorize Device';
        }
        if (b1) {
          b1.disabled = false;
          b1.focus();
          b1.select();
        }
        if (b2) {
          b2.disabled = false;
        }
      }
    }
  </script>
  <%- include('partials/pwa-sw') %>
</body>
</html>
