<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { extraCss: '/css/portal.css' }) %>
  <title><%= config.app.name || 'Auth Gateway' %> - Portal</title>
  <script src="/socket.io/socket.io.js"></script>
</head>
<body>
  <div class="ambient-glow"></div>
  <div class="card card-portal">
    <div class="header">
      <div class="logo-container">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </div>
      <h1><%= config.app.name %></h1>
      <p class="subtitle">Central Authentication &amp; Services Portal</p>
    </div>

    <% if (notice) { %>
      <div class="success-box" id="portal-notice">
        <span class="notice-text"><%= notice %></span>
        <button type="button" class="btn-close-notice" onclick="closePortalNotice()" aria-label="Close notice">
          <svg style="width: 14px; height: 14px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    <% } %>

    <%
      const isTrusted = session && session.isTrusted;
      const friendlyDevice = (session && session.friendlyDevice) || 'Current Device';
      const ip = (session && session.ip) || 'Unknown IP';
      const sessionId = (session && session.id) || '';
      const activeServices = (services || []).filter(s => !s.disableService);
      const isRestrictedSession = Array.isArray(session && session.allowedServices) &&
        session.allowedServices.length > 0 &&
        !session.allowedServices.includes('*');
      const allowedServiceIds = isRestrictedSession
        ? (session.allowedServices || []).map(s => String(s).toLowerCase())
        : null;
      const shouldShowRestricted = typeof showRestricted !== 'undefined' ? Boolean(showRestricted) : false;

      function checkAllowed(s) {
        if (isApproverUser) return true;
        if (typeof isSessionAllowedForService === 'function') {
          return isSessionAllowedForService(session, s);
        }
        if (isRestrictedSession) {
          return allowedServiceIds && allowedServiceIds.includes((s.id || '').toLowerCase());
        }
        return true;
      }

      const visibleServices = activeServices.filter(function(s) {
        const isAllowed = checkAllowed(s);
        return shouldShowRestricted || isAllowed;
      });
    %>

    <div class="session-badge">
      <div>
        <div class="device-title"><%= friendlyDevice %></div>
        <div class="device-sub"><%= ip %></div>
      </div>
      <% const isApproverDevice = isApproverUser || (session && (session.isApprover || session.type === 'approver' || session.approverToken)); %>
      <span class="status-tag <%= isApproverDevice ? 'status-approver' : (isTrusted ? 'status-trusted' : 'status-guest') %>">
        <%= isApproverDevice ? 'Approver Device' : (isTrusted ? 'Trusted Device' : 'Active Session') %>
      </span>
    </div>

    <div class="section-title">Authorized Services</div>
    <div class="services-grid">
      <% if (visibleServices.length === 0) { %>
        <p style="color: #94a3b8; font-size: 0.85rem;">No authorized services available.</p>
      <% } else { %>
        <% visibleServices.forEach(function(s) { 
             const isAllowed = checkAllowed(s);
             const targetUrl = s.url ? ('/launch/' + encodeURIComponent(s.id)) : '#';
        %>
          <div class="service-card <%= !isAllowed ? 'service-card-disabled' : '' %>">
            <div class="service-info">
              <div class="service-name-row">
                <span class="service-name"><%= s.name %></span>
                <% if (s.disableAuth) { %>
                  <span class="badge-public">Public</span>
                <% } %>
              </div>
              <div class="service-desc"><%= s.subtitle || s.url %></div>
            </div>
            <% if (isAllowed) { %>
              <a href="<%= targetUrl %>" class="btn-launch" title="Open <%= s.name %>" target="_blank" rel="noopener noreferrer">
                <span>Open</span>
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            <% } else { %>
              <span class="badge-no-access" style="font-size: 0.75rem; font-weight: 600; color: #94a3b8; background: rgba(255, 255, 255, 0.05); padding: 0.4rem 0.7rem; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.08);">Restricted</span>
            <% } %>
          </div>
        <% }); %>
      <% } %>
    </div>

    <div class="actions-row <%= isApproverUser ? 'actions-row-approver' : '' %>">
      <% if (isApproverUser) { %>
        <div class="actions-approver-group">
          <a href="/auth/sessions" class="btn-action btn-sessions">Sessions</a>
          <a href="/auth/audit" class="btn-action btn-audit">Audit Log</a>
          <button type="button" class="btn-action btn-jail" id="openJailModalBtn" onclick="openJailModal()" title="View and manage jailed IP addresses">
            IP Jail <span id="jailCountBadge" class="badge-jail" style="display: none;">0</span>
          </button>
        </div>
      <% } %>
      <form method="POST" action="/auth/logout" style="display: contents;">
        <button type="submit" class="btn-action btn-logout" style="background: transparent; font-family: inherit; font-size: inherit; cursor: pointer;">Sign Out</button>
      </form>
    </div>

    <div style="text-align: center; margin-top: 1.5rem; font-size: 0.75rem; color: #64748b; line-height: 1.5;">
      <div><%= config.app.footerText %></div>
      <div style="opacity: 0.7; font-size: 0.85em;">v<%= typeof appVersion !== 'undefined' ? appVersion : '1.0.0' %></div>
    </div>
  </div>

  <script>
    let isSigningOut = false;
    const logoutForm = document.querySelector('form[action="/auth/logout"]');
    if (logoutForm) {
      logoutForm.addEventListener('submit', function() {
        isSigningOut = true;
        const btn = logoutForm.querySelector('button[type="submit"]');
        if (btn) {
          btn.disabled = true;
          btn.textContent = 'Signing Out...';
        }
      });
    }

    let isLocked = false;
    function lockCurrentSession(reason) {
      if (isLocked || isSigningOut) return;
      isLocked = true;
      if (socket) {
        try { socket.disconnect(); } catch (e) {}
      }

      const isRevoked = (reason === 'revoked');
      const title = isRevoked ? 'Session Revoked' : 'Session Ended';
      const desc = isRevoked
        ? 'Access for this device was terminated by an approver. Redirecting to login...'
        : 'Your session has ended or expired. Redirecting to login...';

      document.body.innerHTML = '<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at 50% 0%, #1e293b 0%, #090d16 100%); color: #f1f5f9; font-family: inherit; padding: 1.5rem;">' +
        '<div style="background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 24px; padding: 2.25rem 2rem; max-width: 400px; text-align: center; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);">' +
          '<div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(239, 68, 68, 0.15); border: 2px solid #ef4444; color: #ef4444; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1.25rem;">' +
            '<svg style="width: 32px; height: 32px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">' +
              '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />' +
            '</svg>' +
          '</div>' +
          '<h1 style="font-size: 1.35rem; font-weight: 700; margin-bottom: 0.5rem; color: #ffffff;">' + title + '</h1>' +
          '<p style="font-size: 0.9rem; color: #94a3b8; line-height: 1.5; margin-bottom: 1.5rem;">' + desc + '</p>' +
        '</div>' +
      '</div>';
      setTimeout(function() {
        window.location.href = isRevoked ? '/auth/logout?notice=' + encodeURIComponent('Your session was revoked.') : '/auth/logout';
      }, 1000);
    }

    const socket = typeof io !== 'undefined' ? io() : null;
    if (socket) {
      function registerDesktop() {
        if ('<%= sessionId %>') {
          socket.emit('register-desktop', '<%= sessionId %>');
        }
      }
      socket.on('connect', registerDesktop);
      registerDesktop();

      socket.on('session-permissions-updated', function(data) {
        if (data && (data.all || data.sessionId === '<%= sessionId %>')) {
          window.location.reload();
        }
      });

      socket.on('session-revoked', function(data) {
        if (data && (
          data.all ||
          (data.sessionId && data.sessionId === '<%= sessionId %>')
        )) {
          lockCurrentSession('revoked');
        } else {
          fetch('/auth/verify', { cache: 'no-store' }).then(function(r) {
            if (r.status === 401) lockCurrentSession('ended');
          }).catch(function() {});
        }
      });
    }

    setInterval(function() {
      if (isLocked || isSigningOut) return;
      fetch('/auth/verify', { cache: 'no-store' }).then(function(r) {
        if (r.status === 401) {
          lockCurrentSession('ended');
        }
      }).catch(function() {});
    }, 2000);

    function closePortalNotice() {
      const el = document.getElementById('portal-notice');
      if (el) el.style.display = 'none';
      if (window.history && window.history.replaceState) {
        const url = new URL(window.location.href);
        if (url.searchParams.has('notice')) {
          url.searchParams.delete('notice');
          window.history.replaceState({}, '', url.pathname + (url.search ? url.search : '') + url.hash);
        }
      }
    }

    document.addEventListener('visibilitychange', function() {
      if (isLocked || isSigningOut) return;
      if (document.visibilityState === 'visible') {
        fetch('/auth/verify', { cache: 'no-store' }).then(function(r) {
          if (r.status === 401) lockCurrentSession('ended');
        }).catch(function() {});
      }
    });
  </script>
  <% if (isApproverUser) { %>
    <%- include('partials/jailModal') %>
  <% } %>
  <%- include('partials/pwa-sw') %>
</body>
</html>
