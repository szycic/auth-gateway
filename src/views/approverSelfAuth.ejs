<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { extraCss: '/css/approver.css' }) %>
  <title>Approver - Self Authorization</title>
</head>
<body>
  <div class="ambient-glow"></div>
  <div class="card card-md">
    <div class="icon">
      <svg style="width: 32px; height: 32px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v6a2 2 0 002 2z" />
      </svg>
    </div>
    <h1>Approver Device</h1>
    <% 
      let noticeText = 'Your device session is no longer active.';
      if (notice === 'revoked') {
        noticeText = 'Your device session was revoked from the management dashboard.';
      } else if (notice === 'logged_out' || notice === 'logout') {
        noticeText = 'You have signed out of this device session.';
      } else if (notice) {
        noticeText = String(notice);
      }
    %>
    <div class="notice-box" id="selfAuthNotice">
      <span class="notice-text"><%= noticeText %></span>
      <button type="button" class="btn-close-notice" onclick="closeNotice()" aria-label="Close notice">
        <svg style="width: 14px; height: 14px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <script>
      function closeNotice() {
        const el = document.getElementById('selfAuthNotice');
        if (el) el.style.display = 'none';
        if (window.history && window.history.replaceState) {
          const url = new URL(window.location.href);
          if (url.searchParams.has('notice')) {
            url.searchParams.delete('notice');
            window.history.replaceState({}, '', url.pathname + (url.search ? url.search : '') + url.hash);
          }
        }
      }
    </script>
    <p class="desc">As the Approver, you can instantly authorize access to all protected services on this device.</p>
    <form method="POST" action="/auth/approver/self-authorize">
      <input type="hidden" name="redirect" value="<%= redirect %>">
      <button type="submit" class="btn-auth">Authorize This Device</button>
    </form>
    <a href="/auth/sessions" class="btn-link">Open Sessions &amp; QR Scanner</a>
  </div>
  <%- include('partials/pwa-sw') %>
</body>
</html>