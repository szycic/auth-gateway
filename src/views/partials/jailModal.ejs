</style>

<!-- IP Jail Management Modal -->
<div class="jail-modal-overlay" id="jailModalOverlay" onclick="if(event.target===this)closeJailModal()">
  <div class="jail-modal-card" role="dialog" aria-modal="true" aria-labelledby="jailModalTitle">
    <div class="jail-modal-header">
      <div class="jail-modal-title-group">
        <h3 class="jail-modal-title" id="jailModalTitle">
          <svg style="width: 20px; height: 20px; color: #fbbf24;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          IP Jail Management
        </h3>
        <span class="jail-header-pill" id="jailHeaderPill">0 active</span>
      </div>
      <button type="button" class="btn-jail-close" onclick="closeJailModal()" aria-label="Close modal">
        <svg style="width: 20px; height: 20px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="jail-modal-body">
      <!-- Live Toast Container -->
      <div id="jailToastContainer" style="display: none;"></div>

      <!-- Section: Currently Jailed IPs -->
      <div>
        <div class="jail-section-title">
          <span>Active IP Bans</span>
          <span id="jailLastUpdatedText" style="font-weight: 500; font-size: 0.72rem; color: #64748b;">Auto-refreshing</span>
        </div>

        <div id="jailEmptyState" class="jail-empty" style="display: none;">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h4>No IPs currently jailed</h4>
          <p>All client IP addresses are clear. Scanner probes and unauthenticated burst hits are automatically tracked.</p>
        </div>

        <div id="jailItemsContainer" class="jail-items-container">
          <!-- Populated dynamically -->
        </div>
      </div>

      <!-- Section: Manually Jail an IP -->
      <div class="jail-manual-card">
        <div class="jail-section-title" style="margin-bottom: 0.65rem;">
          <span>Manual IP Ban</span>
        </div>
        <form id="jailManualForm" onsubmit="handleManualJailSubmit(event)">
          <div class="jail-form-grid">
            <input type="text" id="manualJailIp" class="jail-input" placeholder="IP Address (e.g. 198.51.100.24)" required />
            <select id="manualJailDuration" class="jail-select" title="Ban Duration">
              <option value="30" selected>30 minutes</option>
              <option value="120">2 hours</option>
              <option value="360">6 hours</option>
              <option value="1440">24 hours</option>
              <option value="10080">7 days</option>
            </select>
            <button type="submit" class="btn-jail-ban-submit" id="btnManualJailSubmit">Jail IP</button>
          </div>
          <div style="margin-top: 0.5rem;">
            <input type="text" id="manualJailReason" class="jail-input" placeholder="Reason (optional, e.g. Aggressive crawler, unauthorized probing)" />
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  let jailCountdownTimer = null;
  let currentJailedList = [];
  window.jailedIpsSet = new Set();

  function openJailModal() {
    const overlay = document.getElementById('jailModalOverlay');
    if (!overlay) return;
    overlay.classList.add('active');
    fetchJailData();
    startJailCountdown();
  }

  function closeJailModal() {
    const overlay = document.getElementById('jailModalOverlay');
    if (!overlay) return;
    overlay.classList.remove('active');
    stopJailCountdown();
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const overlay = document.getElementById('jailModalOverlay');
      if (overlay && overlay.classList.contains('active')) {
        closeJailModal();
      }
    }
  });

  function showJailToast(msg, type = 'success') {
    const c = document.getElementById('jailToastContainer');
    if (!c) return;
    c.style.display = 'block';
    c.className = `jail-toast jail-toast-${type}`;
    c.textContent = msg;
    setTimeout(() => {
      c.style.display = 'none';
    }, 4000);
  }

  async function fetchJailData() {
    try {
      const res = await fetch('/auth/jail/data', {
        headers: { 'Accept': 'application/json' },
      });
      if (!res.ok) return;
      const data = await res.json();
      currentJailedList = data.jailed || [];
      renderJailList(currentJailedList);
      updateJailBadges(currentJailedList.length);
    } catch (err) {
      console.error('Failed to fetch jail data:', err);
    }
  }

  function updateJailBadges(count) {
    window.jailedIpsSet = new Set(currentJailedList.map(item => item.ip));

    const topBadge = document.getElementById('jailCountBadge');
    if (topBadge) {
      if (count > 0) {
        topBadge.textContent = count;
        topBadge.style.display = 'inline-flex';
      } else {
        topBadge.style.display = 'none';
      }
    }

    const modalPill = document.getElementById('jailHeaderPill');
    if (modalPill) {
      if (count > 0) {
        modalPill.className = 'jail-header-pill';
        modalPill.textContent = `${count} active ban${count === 1 ? '' : 's'}`;
      } else {
        modalPill.className = 'jail-header-pill clean';
        modalPill.textContent = 'Clear';
      }
    }

    const updatedText = document.getElementById('jailLastUpdatedText');
    if (updatedText) {
      updatedText.textContent = 'Updated ' + new Date().toLocaleTimeString();
    }
  }

  function formatJailCountdown(bannedUntil) {
    const now = Date.now();
    const remainingMs = bannedUntil - now;
    if (remainingMs <= 0) return 'Expired';

    const totalSeconds = Math.floor(remainingMs / 1000);
    const d = Math.floor(totalSeconds / 86400);
    const h = Math.floor((totalSeconds % 86400) / 3600);
    const m = Math.floor((totalSeconds % 3600) / 60);
    const s = totalSeconds % 60;

    const parts = [];
    if (d > 0) parts.push(`${d}d`);
    if (h > 0 || d > 0) parts.push(`${h}h`);
    parts.push(`${m}m`);
    parts.push(`${s}s`);
    return parts.join(' ') + ' remaining';
  }

  function renderJailList(list) {
    const container = document.getElementById('jailItemsContainer');
    const emptyState = document.getElementById('jailEmptyState');
    if (!container || !emptyState) return;

    if (!list || list.length === 0) {
      emptyState.style.display = 'block';
      container.innerHTML = '';
      return;
    }

    emptyState.style.display = 'none';
    container.innerHTML = '';

    list.forEach(item => {
      const card = document.createElement('div');
      card.className = 'jail-item-card';
      card.id = `jail-card-${item.ip.replace(/[^a-zA-Z0-9]/g, '_')}`;

      const tagClass = item.isManual ? 'jail-tag jail-tag-manual' : 'jail-tag';
      const tagText = item.escalationLevel || '30m';

      const hitsBadge = (item.hitCount && item.hitCount > 0) ? `<span class="jail-meta-chip"><strong>${item.hitCount}</strong> attempts during jail</span>` : '';
      const strikesBadge = (item.count && item.count > 1) ? `<span class="jail-meta-chip">Strike <strong>${item.count}</strong></span>` : '';
      const firstBanned = item.firstBannedAt ? `<span class="jail-meta-chip">First: ${new Date(item.firstBannedAt).toLocaleTimeString()}</span>` : '';

      card.innerHTML = `
        <div class="jail-item-top">
          <div class="jail-ip-wrap">
            <span class="jail-ip-text">${escapeJailHtml(item.ip)}</span>
            <span class="${tagClass}">${escapeJailHtml(tagText)}</span>
          </div>
          <span class="jail-countdown" data-banned-until="${item.bannedUntil}">
            ${formatJailCountdown(item.bannedUntil)}
          </span>
        </div>

        <div class="jail-item-mid">
          <strong>Reason:</strong> ${escapeJailHtml(item.reason || 'Malicious scanner probe')}
        </div>

        <div class="jail-item-meta">
          ${strikesBadge}
          ${hitsBadge}
          ${firstBanned}
        </div>

        <div class="jail-item-bottom">
          <div class="jail-actions-left">
            <button type="button" class="btn-unjail-action" onclick="unjailIp('${escapeJailHtml(item.ip)}')">
              <svg style="width: 14px; height: 14px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              Unjail
            </button>
          </div>
          <div class="jail-extend-wrap">
            <span class="jail-extend-label">Extend:</span>
            <button type="button" class="btn-extend-pill" onclick="extendJail('${escapeJailHtml(item.ip)}', 30)">+30m</button>
            <button type="button" class="btn-extend-pill" onclick="extendJail('${escapeJailHtml(item.ip)}', 120)">+2h</button>
            <button type="button" class="btn-extend-pill" onclick="extendJail('${escapeJailHtml(item.ip)}', 1440)">+24h</button>
          </div>
        </div>
      `;

      container.appendChild(card);
    });
  }

  function startJailCountdown() {
    stopJailCountdown();
    jailCountdownTimer = setInterval(() => {
      const els = document.querySelectorAll('.jail-countdown[data-banned-until]');
      let hasExpired = false;
      els.forEach(el => {
        const bannedUntil = parseInt(el.getAttribute('data-banned-until'), 10);
        if (bannedUntil) {
          const txt = formatJailCountdown(bannedUntil);
          el.textContent = txt;
          if (txt === 'Expired') hasExpired = true;
        }
      });
      if (hasExpired) {
        fetchJailData();
      }
    }, 1000);
  }

  function stopJailCountdown() {
    if (jailCountdownTimer) {
      clearInterval(jailCountdownTimer);
      jailCountdownTimer = null;
    }
  }

  async function unjailIp(ip) {
    if (!ip) return;
    try {
      const res = await fetch('/auth/jail/unjail', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify({ ip }),
      });
      const data = await res.json();
      if (!res.ok || data.error) {
        showJailToast(data.error || 'Failed to unjail IP', 'error');
        return;
      }
      showJailToast(`IP ${ip} unjailed successfully`, 'success');
      currentJailedList = data.jailed || [];
      renderJailList(currentJailedList);
      updateJailBadges(currentJailedList.length);

      // If on audit dashboard, trigger refresh
      if (typeof fetchAuditLogs === 'function') {
        fetchAuditLogs();
      }
    } catch (err) {
      showJailToast('Network error while unjailing IP', 'error');
    }
  }
  window.unjailIp = unjailIp;

  async function extendJail(ip, durationMinutes) {
    if (!ip) return;
    try {
      const res = await fetch('/auth/jail/extend', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify({ ip, durationMinutes }),
      });
      const data = await res.json();
      if (!res.ok || data.error) {
        showJailToast(data.error || 'Failed to extend jail', 'error');
        return;
      }
      showJailToast(`Jail for ${ip} extended by ${durationMinutes}m`, 'success');
      currentJailedList = data.jailed || [];
      renderJailList(currentJailedList);
      updateJailBadges(currentJailedList.length);
    } catch (err) {
      showJailToast('Network error while extending jail', 'error');
    }
  }

  async function handleManualJailSubmit(e) {
    e.preventDefault();
    const ipInput = document.getElementById('manualJailIp');
    const durSelect = document.getElementById('manualJailDuration');
    const reasonInput = document.getElementById('manualJailReason');
    const submitBtn = document.getElementById('btnManualJailSubmit');

    const ip = ipInput ? ipInput.value.trim() : '';
    const durationMinutes = durSelect ? parseInt(durSelect.value, 10) : 30;
    const reason = reasonInput ? reasonInput.value.trim() : '';

    if (!ip) return;

    if (submitBtn) submitBtn.disabled = true;

    try {
      const res = await fetch('/auth/jail/ban', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify({ ip, durationMinutes, reason }),
      });
      const data = await res.json();
      if (!res.ok || data.error) {
        showJailToast(data.error || 'Failed to jail IP', 'error');
        return;
      }
      showJailToast(`IP ${ip} jailed for ${durationMinutes}m`, 'success');
      if (ipInput) ipInput.value = '';
      if (reasonInput) reasonInput.value = '';
      currentJailedList = data.jailed || [];
      renderJailList(currentJailedList);
      updateJailBadges(currentJailedList.length);
    } catch (err) {
      showJailToast('Network error while jailing IP', 'error');
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  }

  function escapeJailHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Initial badge check on load
  document.addEventListener('DOMContentLoaded', () => {
    fetchJailData();
    setInterval(fetchJailData, 30000);
  });
</script>
