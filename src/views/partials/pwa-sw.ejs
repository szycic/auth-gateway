<%
  let authOrigin = '';
  try {
    authOrigin = (config && config.server && config.server.baseUrl) ? new URL(config.server.baseUrl).origin : '';
  } catch (_) {}
%>
<script>
  if ('serviceWorker' in navigator && (!'<%= authOrigin %>' || window.location.origin === '<%= authOrigin %>')) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js', { scope: '/' })
        .catch(err => console.warn('[PWA] ServiceWorker registration failed:', err));
    });
  }
</script>
