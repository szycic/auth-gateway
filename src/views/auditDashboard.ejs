<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { extraCss: '/css/audit.css' }) %>
  <title>Security Audit Log - <%= config.app.name %></title>
</head>
<body>
  <div class="ambient-glow"></div>

  <div class="audit-container">
    <!-- Top Navigation Bar -->
    <div class="top-bar">
      <h1>Security Audit Log</h1>
      <div class="top-bar-actions">
        <a href="/" class="btn-header btn-header-portal">Portal</a>
        <a href="/auth/sessions" class="btn-header btn-header-sessions">Sessions</a>
        <form method="POST" action="/auth/approver/logout" style="display: contents;">
          <button type="submit" class="btn-header btn-header-logout">Sign Out</button>
        </form>
      </div>
    </div>

    <!-- 24-Hour Metric Stat Cards -->
    <div class="stats-grid">
      <div class="stat-card stat-card-logins" onclick="setClassFilter('success')" style="cursor: pointer;" title="Filter by Success (Green)">
        <span class="stat-label">Logins (24h)</span>
        <span class="stat-value" id="statLogins"><%= stats.logins24h %></span>
        <span class="stat-subtext">Successful user &amp; approver logins</span>
      </div>
      <div class="stat-card stat-card-alerts" onclick="setClassFilter('danger')" style="cursor: pointer;" title="Filter by Danger (Red)">
        <span class="stat-label">Security Alerts (24h)</span>
        <span class="stat-value" id="statAlerts"><%= stats.securityAlerts24h %></span>
        <span class="stat-subtext">CSRF &amp; cross-domain blocks</span>
      </div>
      <div class="stat-card stat-card-lockouts" onclick="setClassFilter('danger')" style="cursor: pointer;" title="Filter by Danger (Red)">
        <span class="stat-label">Lockouts &amp; Fails (24h)</span>
        <span class="stat-value" id="statLockouts"><%= stats.lockouts24h %></span>
        <span class="stat-subtext">Anti-brute-force rate limits</span>
      </div>
      <div class="stat-card stat-card-events" onclick="setClassFilter('')" style="cursor: pointer;" title="Show all event classes">
        <span class="stat-label">Tracked Events</span>
        <span class="stat-value" id="statTotal"><%= stats.totalEvents %></span>
        <span class="stat-subtext">Unique IPs: <strong id="statIps" style="color: #cbd5e1;"><%= stats.uniqueIps24h %></strong> (24h)</span>
      </div>
    </div>

    <!-- Filter & Search Controls -->
    <div class="audit-controls-card">
      <div class="controls-bar">
        <div class="search-box-wrapper">
          <svg class="search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input type="text" id="searchInput" class="search-input" placeholder="Search by IP, device, path, event, or metadata..." autocomplete="off">
        </div>

        <select id="timeRangeSelect" class="select-filter">
          <option value="">All Time</option>
          <option value="1h">Last 1 Hour</option>
          <option value="24h" selected>Last 24 Hours</option>
          <option value="7d">Last 7 Days</option>
          <option value="30d">Last 30 Days</option>
        </select>

        <select id="classSelect" class="select-filter" title="Filter by event class">
          <option value="" <%= (typeof initialClass === 'undefined' || !initialClass) ? 'selected' : '' %>>All Classes</option>
          <option value="danger" <%= (typeof initialClass !== 'undefined' && initialClass === 'danger') ? 'selected' : '' %>>Danger (Red)</option>
          <option value="warning" <%= (typeof initialClass !== 'undefined' && initialClass === 'warning') ? 'selected' : '' %>>Warning (Amber)</option>
          <option value="purple" <%= (typeof initialClass !== 'undefined' && initialClass === 'purple') ? 'selected' : '' %>>Credentials (Purple)</option>
          <option value="info" <%= (typeof initialClass !== 'undefined' && initialClass === 'info') ? 'selected' : '' %>>Info (Blue)</option>
          <option value="success" <%= (typeof initialClass !== 'undefined' && initialClass === 'success') ? 'selected' : '' %>>Success (Green)</option>
        </select>

        <select id="eventSelect" class="select-filter">
          <option value="">All Event Types</option>
          <% if (typeof eventTypes !== 'undefined' && eventTypes && eventTypes.length > 0) { %>
            <% eventTypes.forEach(function(ev) { %>
              <option value="<%= ev %>"><%= ev %></option>
            <% }); %>
          <% } %>
        </select>

        <select id="sortSelect" class="select-filter" title="Sort order">
          <option value="time-desc" selected>Sort: Newest First</option>
          <option value="time-asc">Sort: Oldest First</option>
          <option value="class-desc">Sort: Severity (High to Low)</option>
          <option value="class-asc">Sort: Severity (Low to High)</option>
        </select>
      </div>
    </div>

    <!-- Audit Event Log Table -->
    <div class="audit-table-card">
      <div class="table-header-meta">
        <div class="meta-status">
          <span>Showing <strong id="countFiltered" style="color: #ffffff;">0</strong> of <strong id="countTotal" style="color: #ffffff;">0</strong> events</span>
          <span class="meta-dot">•</span>
          <span id="lastUpdatedText" style="color: #64748b;">Updated just now</span>
        </div>

        <div class="export-actions">
          <button type="button" class="btn-export" onclick="exportData('csv')" title="Download CSV">
            <svg style="width: 14px; height: 14px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            CSV
          </button>
          <button type="button" class="btn-export" onclick="exportData('json')" title="Download JSON">
            <svg style="width: 14px; height: 14px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            JSON
          </button>
          <button type="button" id="btnAutoRefresh" class="btn-export" style="color: #38bdf8;" onclick="toggleAutoRefresh()" title="Toggle live auto-refresh">
            Auto: On
          </button>
        </div>
      </div>

      <div style="overflow-x: auto;">
        <table class="audit-table">
          <thead>
            <tr>
              <th style="width: 140px; cursor: pointer; user-select: none;" id="thTime" onclick="cycleSort('time')" title="Click to toggle Time sort">
                Time <span id="sortIconTime" class="sort-icon active">▼</span>
              </th>
              <th style="width: 190px; cursor: pointer; user-select: none;" id="thEvent" onclick="cycleSort('class')" title="Click to toggle Event Class sort">
                Event <span id="sortIconClass" class="sort-icon">↕</span>
              </th>
              <th style="width: 220px;">Actor / Origin</th>
              <th>Details &amp; Context</th>
            </tr>
          </thead>
          <tbody id="auditTableBody">
            <!-- Dynamic rows populated via JS -->
          </tbody>
        </table>
      </div>

      <div id="auditEmptyState" class="audit-empty" style="display: none;">
        <svg style="width: 48px; height: 48px; margin: 0 auto; color: #475569;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <p>No audit events match the selected criteria.</p>
      </div>

      <div class="pagination-bar">
        <span id="paginationInfo">Page 1</span>
        <div class="pagination-controls">
          <button id="btnPrevPage" class="btn-page" onclick="changePage(-1)" disabled>&larr; Prev</button>
          <button id="btnNextPage" class="btn-page" onclick="changePage(1)" disabled>Next &rarr;</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let currentSearch = '';
    let currentTimeRange = '24h';
    let currentEvent = '';
    let currentClass = '<%= typeof initialClass !== "undefined" && initialClass ? initialClass : "" %>';
    let currentSort = 'time-desc';
    let currentOffset = 0;
    const pageSize = 50;
    let autoRefreshTimer = null;
    let autoRefreshEnabled = true;

    function getFromTimestamp(range) {
      const now = Date.now();
      if (range === '1h') return new Date(now - 3600 * 1000).toISOString();
      if (range === '24h') return new Date(now - 24 * 3600 * 1000).toISOString();
      if (range === '7d') return new Date(now - 7 * 24 * 3600 * 1000).toISOString();
      if (range === '30d') return new Date(now - 30 * 24 * 3600 * 1000).toISOString();
      return '';
    }

    function formatRelativeTime(dateStr) {
      const ms = Date.now() - new Date(dateStr).getTime();
      const s = Math.floor(ms / 1000);
      if (s < 10) return 'Just now';
      if (s < 60) return `${s}s ago`;
      const m = Math.floor(s / 60);
      if (m < 60) return `${m}m ago`;
      const h = Math.floor(m / 60);
      if (h < 24) return `${h}h ago`;
      const d = Math.floor(h / 24);
      return `${d}d ago`;
    }

    function getEventClass(event = '') {
      const ev = String(event);
      if (ev.includes('BLOCKED') || ev.includes('FAILED') || ev.includes('LOCKOUT') || ev.includes('RATE_LIMIT')) {
        return 'danger';
      }
      if (ev.includes('REVOKED') || ev.includes('LOGOUT') || ev.includes('REJECTED')) {
        return 'warning';
      }
      if (ev.includes('FIDO') || ev.includes('KEY') || ev.includes('METHOD')) {
        return 'purple';
      }
      if (ev.includes('SUCCESS') || ev.includes('APPROVED')) {
        return 'success';
      }
      return 'info';
    }

    function getEventBadgeClass(event) {
      return `badge-${getEventClass(event)}`;
    }

    function setClassFilter(cls) {
      if (currentClass === cls) {
        currentClass = '';
      } else {
        currentClass = cls;
      }
      const sel = document.getElementById('classSelect');
      if (sel) sel.value = currentClass;
      currentOffset = 0;
      openDrawers.clear();
      fetchAuditLogs();
    }

    async function fetchAuditLogs() {
      const params = new URLSearchParams({
        sort: currentSort,
        event: currentEvent,
        eventClass: currentClass,
        search: currentSearch,
        from: getFromTimestamp(currentTimeRange),
        limit: pageSize,
        offset: currentOffset,
      });

      try {
        const res = await fetch(`/auth/audit/api?${params.toString()}`);
        if (!res.ok) throw new Error('Failed to load audit logs');
        const data = await res.json();
        renderAuditLogs(data);
      } catch (err) {
        console.error('Audit fetch error:', err);
      }
    }

    function updateEventSelect(eventTypes) {
      if (!Array.isArray(eventTypes)) return;
      const select = document.getElementById('eventSelect');
      const currentVal = select.value;

      const existingOptions = Array.from(select.options).slice(1).map(opt => opt.value);
      const isSame = existingOptions.length === eventTypes.length &&
        existingOptions.every((val, idx) => val === eventTypes[idx]);

      if (isSame) return;

      select.innerHTML = '<option value="">All Event Types</option>';
      for (const ev of eventTypes) {
        const opt = document.createElement('option');
        opt.value = ev;
        opt.textContent = ev;
        if (ev === currentVal) {
          opt.selected = true;
        }
        select.appendChild(opt);
      }

      if (currentVal && !eventTypes.includes(currentVal)) {
        currentEvent = '';
      }
    }

    const openDrawers = new Set();

    function renderAuditLogs(data) {
      const tbody = document.getElementById('auditTableBody');
      const emptyEl = document.getElementById('auditEmptyState');

      if (data.eventTypes) {
        updateEventSelect(data.eventTypes);
      }

      // Preserve currently open drawer IDs before clearing DOM
      document.querySelectorAll('.audit-drawer-row.open').forEach(el => {
        const id = el.id.replace(/^drawer-/, '');
        if (id) openDrawers.add(id);
      });

      tbody.innerHTML = '';

      if (data.stats) {
        document.getElementById('statLogins').textContent = data.stats.logins24h || 0;
        document.getElementById('statAlerts').textContent = data.stats.securityAlerts24h || 0;
        document.getElementById('statLockouts').textContent = data.stats.lockouts24h || 0;
        document.getElementById('statTotal').textContent = data.stats.totalEvents || 0;
        document.getElementById('statIps').textContent = data.stats.uniqueIps24h || 0;
      }

      document.getElementById('countFiltered').textContent = data.filteredCount || 0;
      document.getElementById('countTotal').textContent = data.total || 0;
      document.getElementById('lastUpdatedText').textContent = 'Updated ' + new Date().toLocaleTimeString();

      const logs = data.logs || [];
      if (logs.length === 0) {
        emptyEl.style.display = 'block';
      } else {
        emptyEl.style.display = 'none';

        logs.forEach((log) => {
          const logId = String(log.id || `${new Date(log.timestamp).getTime()}-${log.event}`);
          const isOpen = openDrawers.has(logId);

          const row = document.createElement('tr');
          row.id = `row-${logId}`;
          row.className = 'audit-row' + (isOpen ? ' expanded' : '');
          row.onclick = () => toggleDrawer(logId);

          const cls = getEventClass(log.event);
          const badgeCls = `badge-${cls}`;
          const d = log.details || {};
          const ip = d.ip || d.clientIp || d.approverIp || '-';
          const device = d.friendlyDevice || d.device || d.targetDevice || d.approverDevice || '';
          const uuid = d.sessionId || d.uuid || '';

          // Format detail chips
          const chips = [];
          for (const [k, v] of Object.entries(d)) {
            if (['ip', 'clientIp', 'approverIp', 'friendlyDevice', 'device', 'targetDevice', 'approverDevice', 'userAgent', 'sessionId', 'uuid'].includes(k)) continue;
            const strVal = typeof v === 'object' ? JSON.stringify(v) : String(v);
            chips.push(`<span class="detail-chip"><strong>${k}:</strong> ${escapeHtml(strVal)}</span>`);
          }

          row.innerHTML = `
            <td class="col-time">
              <div class="time-rel">${formatRelativeTime(log.timestamp)}</div>
              <div class="time-full">${new Date(log.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })}</div>
            </td>
            <td>
              <span class="event-badge ${badgeCls}" onclick="event.stopPropagation(); setClassFilter('${cls}')" title="Filter by '${cls}' class">
                ${escapeHtml(log.event)}
              </span>
            </td>
            <td>
              <div class="col-actor">
                <span class="ip-text">${escapeHtml(ip)}</span>
                ${device ? `<span class="device-pill">${escapeHtml(device)}</span>` : ''}
                ${uuid ? `<span class="device-uuid" title="UUID: ${escapeHtml(uuid)} (Click to copy)" onclick="event.stopPropagation(); copyUuid(this, '${escapeHtml(uuid)}')">${escapeHtml(uuid)}</span>` : ''}
              </div>
            </td>
            <td>
              <div class="col-details">
                ${chips.join('') || '<span style="color: #64748b; font-size: 0.75rem;">None</span>'}
              </div>
            </td>
          `;

          // Hidden expandable JSON drawer row
          const drawerRow = document.createElement('tr');
          drawerRow.id = `drawer-${logId}`;
          drawerRow.className = 'audit-drawer-row' + (isOpen ? ' open' : '');
          drawerRow.innerHTML = `
            <td colspan="4" class="audit-drawer-content">
              <pre class="json-view">${escapeHtml(JSON.stringify(log, null, 2))}</pre>
            </td>
          `;

          tbody.appendChild(row);
          tbody.appendChild(drawerRow);
        });
      }

      // Pagination
      const pageNum = Math.floor(currentOffset / pageSize) + 1;
      const totalPages = Math.ceil((data.filteredCount || 1) / pageSize) || 1;
      document.getElementById('paginationInfo').textContent = `Page ${pageNum} of ${totalPages}`;
      document.getElementById('btnPrevPage').disabled = currentOffset <= 0;
      document.getElementById('btnNextPage').disabled = currentOffset + pageSize >= (data.filteredCount || 0);
    }

    function toggleDrawer(id) {
      const logId = String(id);
      const el = document.getElementById(`drawer-${logId}`);
      const row = document.getElementById(`row-${logId}`);
      if (!el) return;
      if (openDrawers.has(logId)) {
        openDrawers.delete(logId);
        el.classList.remove('open');
        if (row) row.classList.remove('expanded');
      } else {
        openDrawers.add(logId);
        el.classList.add('open');
        if (row) row.classList.add('expanded');
      }
    }

    function changePage(direction) {
      currentOffset = Math.max(0, currentOffset + direction * pageSize);
      openDrawers.clear();
      fetchAuditLogs();
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function copyUuid(el, text) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text);
        const originalText = el.textContent;
        el.textContent = 'Copied!';
        el.style.color = '#34d399';
        setTimeout(() => {
          el.textContent = originalText;
          el.style.color = '';
        }, 1200);
      }
    }

    function exportData(format) {
      const params = new URLSearchParams({
        format,
        sort: currentSort,
        event: currentEvent,
        eventClass: currentClass,
        search: currentSearch,
        from: getFromTimestamp(currentTimeRange),
      });
      window.location.href = `/auth/audit/export?${params.toString()}`;
    }

    function toggleAutoRefresh() {
      autoRefreshEnabled = !autoRefreshEnabled;
      const btn = document.getElementById('btnAutoRefresh');
      if (autoRefreshEnabled) {
        btn.textContent = 'Auto: On';
        btn.style.color = '#38bdf8';
        startPolling();
      } else {
        btn.textContent = 'Auto: Off';
        btn.style.color = '#94a3b8';
        if (autoRefreshTimer) clearInterval(autoRefreshTimer);
      }
    }

    function startPolling() {
      if (autoRefreshTimer) clearInterval(autoRefreshTimer);
      autoRefreshTimer = setInterval(() => {
        if (autoRefreshEnabled && currentOffset === 0) {
          fetchAuditLogs();
        }
      }, 5000);
    }

    function updateSortIcons() {
      const timeIcon = document.getElementById('sortIconTime');
      const classIcon = document.getElementById('sortIconClass');
      const sortSelect = document.getElementById('sortSelect');

      if (sortSelect) sortSelect.value = currentSort;

      if (timeIcon) {
        timeIcon.classList.remove('active');
        if (currentSort === 'time-desc') {
          timeIcon.textContent = '▼';
          timeIcon.classList.add('active');
        } else if (currentSort === 'time-asc') {
          timeIcon.textContent = '▲';
          timeIcon.classList.add('active');
        } else {
          timeIcon.textContent = '↕';
        }
      }

      if (classIcon) {
        classIcon.classList.remove('active');
        if (currentSort === 'class-desc') {
          classIcon.textContent = '▼';
          classIcon.classList.add('active');
        } else if (currentSort === 'class-asc') {
          classIcon.textContent = '▲';
          classIcon.classList.add('active');
        } else {
          classIcon.textContent = '↕';
        }
      }
    }

    function cycleSort(type) {
      if (type === 'class') {
        if (currentSort === 'class-desc') {
          currentSort = 'class-asc';
        } else if (currentSort === 'class-asc') {
          currentSort = 'time-desc';
        } else {
          currentSort = 'class-desc';
        }
      } else if (type === 'time') {
        if (currentSort === 'time-desc') {
          currentSort = 'time-asc';
        } else {
          currentSort = 'time-desc';
        }
      }
      currentOffset = 0;
      openDrawers.clear();
      updateSortIcons();
      fetchAuditLogs();
    }

    // Sort listener
    document.getElementById('sortSelect').addEventListener('change', (e) => {
      currentSort = e.target.value;
      currentOffset = 0;
      openDrawers.clear();
      updateSortIcons();
      fetchAuditLogs();
    });

    // Class filter listener
    document.getElementById('classSelect').addEventListener('change', (e) => {
      currentClass = e.target.value;
      currentOffset = 0;
      openDrawers.clear();
      fetchAuditLogs();
    });

    // Time Range listener
    document.getElementById('timeRangeSelect').addEventListener('change', (e) => {
      currentTimeRange = e.target.value;
      currentOffset = 0;
      openDrawers.clear();
      fetchAuditLogs();
    });

    // Specific Event listener
    document.getElementById('eventSelect').addEventListener('change', (e) => {
      currentEvent = e.target.value;
      currentOffset = 0;
      openDrawers.clear();
      fetchAuditLogs();
    });

    // Search input with 300ms debounce
    let searchDebounce = null;
    document.getElementById('searchInput').addEventListener('input', (e) => {
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(() => {
        currentSearch = e.target.value;
        currentOffset = 0;
        openDrawers.clear();
        fetchAuditLogs();
      }, 300);
    });

    // Initial load
    fetchAuditLogs();
    startPolling();
  </script>
  <%- include('partials/pwa-sw') %>
</body>
</html>

