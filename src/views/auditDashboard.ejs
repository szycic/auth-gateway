<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { extraCss: '/css/audit.css' }) %>
  <title>Security Audit Log - <%= config.app.name %></title>
</head>
<body>
  <div class="ambient-glow"></div>

  <div class="audit-container">
    <!-- Top Navigation Bar -->
    <div class="top-bar">
      <h1>Security Audit Log</h1>
      <div class="top-bar-actions">
        <a href="/" class="btn-header btn-header-portal">Portal</a>
        <a href="/auth/sessions" class="btn-header btn-header-sessions">Sessions</a>
        <form method="POST" action="/auth/approver/logout" style="display: contents;">
          <button type="submit" class="btn-header btn-header-logout">Sign Out</button>
        </form>
      </div>
    </div>

    <!-- 24-Hour Metric Stat Cards -->
    <div class="stats-grid">
      <div class="stat-card stat-card-alerts">
        <span class="stat-label">Security Alerts (24h)</span>
        <span class="stat-value" id="statAlerts"><%= stats.securityAlerts24h %></span>
        <span class="stat-subtext">CSRF &amp; cross-domain blocks</span>
      </div>
      <div class="stat-card stat-card-warnings">
        <span class="stat-label">Warnings (24h)</span>
        <span class="stat-value" id="statWarnings"><%= stats.warnings24h !== undefined ? stats.warnings24h : (stats.lockouts24h || 0) %></span>
        <span class="stat-subtext">Rate limits &amp; scanner probes</span>
      </div>
      <div class="stat-card stat-card-logins">
        <span class="stat-label">Logins (24h)</span>
        <span class="stat-value" id="statLogins"><%= stats.logins24h %></span>
        <span class="stat-subtext">Successful logins</span>
      </div>
      <div class="stat-card stat-card-events">
        <span class="stat-label">Tracked Events (24h)</span>
        <span class="stat-value" id="statTotal"><%= stats.total24h %></span>
        <span class="stat-subtext">Unique IPs: <strong id="statIps" style="color: #cbd5e1;"><%= stats.uniqueIps24h %></strong></span>
      </div>
    </div>

    <!-- Filter & Search Controls -->
    <div class="audit-controls-card">
      <div class="controls-bar">
        <div class="search-box-wrapper">
          <svg class="search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input type="text" id="searchInput" class="search-input" placeholder="Search by IP, device, path, or event..." autocomplete="off">
        </div>

        <div class="filters-row">
          <!-- Class Multiselect -->
          <div class="multiselect-wrapper wrapper-class" id="classMultiselectWrapper">
            <button type="button" class="select-filter select-class multiselect-trigger" id="classDropdownBtn" onclick="toggleDropdown('class')" aria-haspopup="true" aria-expanded="false" title="Filter by event classes">
              <span class="multiselect-label" id="classSelectLabel">All Classes</span>
              <svg class="dropdown-arrow" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
            <div class="multiselect-menu menu-class" id="classDropdownMenu">
              <div class="multiselect-header">
                <span>Classes</span>
                <button type="button" class="btn-text-action" onclick="selectAllClasses(false)">Clear</button>
              </div>
              <div class="multiselect-items" id="classItemsContainer"></div>
            </div>
          </div>

          <!-- Event Type Multiselect -->
          <div class="multiselect-wrapper wrapper-event" id="eventMultiselectWrapper">
            <button type="button" class="select-filter select-event multiselect-trigger" id="eventDropdownBtn" onclick="toggleDropdown('event')" aria-haspopup="true" aria-expanded="false" title="Filter by event types">
              <span class="multiselect-label" id="eventSelectLabel">All Event Types</span>
              <svg class="dropdown-arrow" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
            <div class="multiselect-menu menu-event" id="eventDropdownMenu">
              <div class="multiselect-header">
                <input type="text" id="eventFilterQuickSearch" class="multiselect-search-input" placeholder="Search event types..." autocomplete="off">
                <button type="button" class="btn-text-action" onclick="selectAllEvents(false)">Clear</button>
              </div>
              <div class="multiselect-items" id="eventItemsContainer"></div>
            </div>
          </div>

          <!-- Time Range Dropdown -->
          <div class="multiselect-wrapper wrapper-time" id="timeDropdownWrapper">
            <button type="button" class="select-filter select-time multiselect-trigger" id="timeDropdownBtn" onclick="toggleDropdown('time')" aria-haspopup="true" aria-expanded="false" title="Filter by time range">
              <span class="multiselect-label" id="timeSelectLabel">Last 24 Hours</span>
              <svg class="dropdown-arrow" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
            <div class="multiselect-menu menu-time" id="timeDropdownMenu">
              <div class="multiselect-items" id="timeItemsContainer"></div>
            </div>
          </div>

          <!-- Sort Order Dropdown -->
          <div class="multiselect-wrapper wrapper-sort" id="sortDropdownWrapper">
            <button type="button" class="select-filter select-sort multiselect-trigger" id="sortDropdownBtn" onclick="toggleDropdown('sort')" aria-haspopup="true" aria-expanded="false" title="Sort order">
              <span class="multiselect-label" id="sortSelectLabel">Newest First</span>
              <svg class="dropdown-arrow" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
            <div class="multiselect-menu menu-sort" id="sortDropdownMenu">
              <div class="multiselect-items" id="sortItemsContainer"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile-only export & auto-refresh toolbar -->
      <div class="export-actions export-actions-mobile">
        <button type="button" class="btn-export" onclick="exportData('csv')">
          <svg style="width: 14px; height: 14px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          CSV
        </button>
        <button type="button" class="btn-export" onclick="exportData('json')">
          <svg style="width: 14px; height: 14px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          JSON
        </button>
        <button type="button" class="btn-export btn-manual-refresh" onclick="manualRefresh()" title="Refresh logs now">
          <svg class="refresh-icon" style="width: 14px; height: 14px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Refresh
        </button>
        <button type="button" class="btn-export btn-auto-refresh" style="color: #38bdf8;" onclick="toggleAutoRefresh()">
          Auto: On
        </button>
      </div>
    </div>

    <!-- Audit Event Log Table -->
    <div class="audit-table-card">
      <div class="table-header-meta">
        <div class="meta-status">
          <span id="countSummarySpan">Showing <strong id="countVisible" style="color: #ffffff;">0</strong> of <strong id="countTotal" style="color: #ffffff;">0</strong> events<span id="filteredMatchNote" style="display: none; color: #94a3b8; font-size: 0.775rem; white-space: nowrap;"> (<strong id="countFilteredMatch" style="color: #cbd5e1;">0</strong> <span id="filteredMatchLabel">matching filters</span>)</span></span>
          <span id="updateDot" class="meta-dot">•</span>
          <span id="lastUpdatedText" style="color: #64748b; white-space: nowrap;">Updated just now</span>
          <span id="clearDot" class="meta-dot" style="display: none;">•</span>
          <button type="button" id="btnClearFilters" class="btn-clear-pill" onclick="clearAllFilters()" style="display: none;" title="Reset all search &amp; filter criteria">
            <svg style="width: 11px; height: 11px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            Clear filters
          </button>
        </div>

        <!-- Desktop-only export & auto-refresh toolbar -->
        <div class="export-actions export-actions-desktop">
          <button type="button" class="btn-export" onclick="exportData('csv')" title="Download CSV">
            <svg style="width: 14px; height: 14px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            CSV
          </button>
          <button type="button" class="btn-export" onclick="exportData('json')" title="Download JSON">
            <svg style="width: 14px; height: 14px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            JSON
          </button>
          <button type="button" class="btn-export btn-manual-refresh" onclick="manualRefresh()" title="Refresh logs now">
            <svg class="refresh-icon" style="width: 14px; height: 14px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Refresh
          </button>
          <button type="button" class="btn-export btn-auto-refresh" style="color: #38bdf8;" onclick="toggleAutoRefresh()" title="Toggle live auto-refresh">
            Auto: On
          </button>
        </div>
      </div>

      <div style="overflow-x: auto;">
        <table class="audit-table">
          <thead>
            <tr>
              <th style="width: 140px; cursor: pointer; user-select: none;" id="thTime" onclick="cycleSort('time')" title="Click to toggle Time sort">
                Time <span id="sortIconTime" class="sort-icon active">▼</span>
              </th>
              <th style="width: 190px; cursor: pointer; user-select: none;" id="thEvent" onclick="cycleSort('class')" title="Click to toggle Event Class sort">
                <span class="th-label-desktop">Event</span><span class="th-label-mobile">Event / Actor</span> <span id="sortIconClass" class="sort-icon">↕</span>
              </th>
              <th style="width: 220px;">Actor / Origin</th>
              <th>Details &amp; Context</th>
            </tr>
          </thead>
          <tbody id="auditTableBody">
            <!-- Dynamic rows populated via JS -->
          </tbody>
        </table>
      </div>

      <div id="auditEmptyState" class="audit-empty" style="display: none;">
        <svg style="width: 48px; height: 48px; margin: 0 auto; color: #475569;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <p>No audit events match the selected criteria.</p>
      </div>

      <div class="pagination-bar">
        <div class="pagination-size">
          <label for="pageSizeSelect">Per page:</label>
          <select id="pageSizeSelect" class="select-page-size" onchange="changePageSize(this.value)" title="Choose number of events per page">
            <option value="25">25</option>
            <option value="50" selected>50</option>
            <option value="100">100</option>
            <option value="200">200</option>
          </select>
        </div>
        <div class="pagination-right">
          <span id="paginationInfo">Page 1</span>
          <div class="pagination-controls">
            <button id="btnPrevPage" class="btn-page" onclick="changePage(-1)" disabled>&larr; Prev</button>
            <button id="btnNextPage" class="btn-page" onclick="changePage(1)" disabled>Next &rarr;</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    let currentSearch = '';
    let currentTimeRange = '24h';
    let currentClasses = (() => {
      const init = '<%= typeof initialClass !== "undefined" && initialClass ? initialClass : "" %>';
      if (!init) return [];
      return init.split(',').map(s => s.trim().toLowerCase()).filter(Boolean);
    })();
    let currentEvents = [];
    let currentSort = 'time-desc';
    let currentOffset = 0;
    let latestEventTypes = <%- JSON.stringify(typeof eventTypes !== 'undefined' ? eventTypes : []) %>;
    let pageSize = (() => {
      try {
        const saved = parseInt(localStorage.getItem('audit_page_size'), 10);
        if ([25, 50, 100, 200].includes(saved)) return saved;
      } catch (_) {}
      return 50;
    })();
    let autoRefreshTimer = null;
    let autoRefreshEnabled = true;

    function getFromTimestamp(range) {
      const now = Date.now();
      if (range === '1h') return new Date(now - 3600 * 1000).toISOString();
      if (range === '24h') return new Date(now - 24 * 3600 * 1000).toISOString();
      if (range === '7d') return new Date(now - 7 * 24 * 3600 * 1000).toISOString();
      if (range === '30d') return new Date(now - 30 * 24 * 3600 * 1000).toISOString();
      return '';
    }

    function formatRelativeTime(dateStr) {
      const ms = Date.now() - new Date(dateStr).getTime();
      const s = Math.floor(ms / 1000);
      if (s < 10) return 'Just now';
      if (s < 60) return `${s}s ago`;
      const m = Math.floor(s / 60);
      if (m < 60) return `${m}m ago`;
      const h = Math.floor(m / 60);
      if (h < 24) return `${h}h ago`;
      const d = Math.floor(h / 24);
      return `${d}d ago`;
    }

    function getEventClass(event = '') {
      const ev = String(event);
      if (ev.includes('SCANNER_') || ev.includes('RATE_LIMIT')) {
        return 'warning';
      }
      if (ev.includes('BLOCKED') || ev.includes('FAILED') || ev.includes('LOCKOUT')) {
        return 'danger';
      }
      if (ev.includes('LOGOUT') || ev.includes('REVOKED')) {
        return 'purple';
      }
      if (ev.includes('SUCCESS') || ev.includes('APPROVED')) {
        return 'success';
      }
      return 'info';
    }

    function getEventBadgeClass(event) {
      return `badge-${getEventClass(event)}`;
    }

    const TIME_RANGES = [
      { value: '', label: 'All Time' },
      { value: '1h', label: 'Last 1 Hour' },
      { value: '24h', label: 'Last 24 Hours' },
      { value: '7d', label: 'Last 7 Days' },
      { value: '30d', label: 'Last 30 Days' },
    ];

    function renderTimeDropdown() {
      const container = document.getElementById('timeItemsContainer');
      const labelEl = document.getElementById('timeSelectLabel');
      const btn = document.getElementById('timeDropdownBtn');
      if (!container) return;
      container.innerHTML = '';

      const found = TIME_RANGES.find(t => t.value === currentTimeRange) || TIME_RANGES[2];
      if (labelEl) labelEl.textContent = found.label;
      if (btn) btn.title = `Time range: ${found.label}`;

      TIME_RANGES.forEach(item => {
        const isSelected = item.value === currentTimeRange;
        const row = document.createElement('div');
        row.className = 'multiselect-item' + (isSelected ? ' selected' : '');
        row.onclick = (e) => {
          e.stopPropagation();
          setTimeRange(item.value);
        };

        const span = document.createElement('span');
        span.textContent = item.label;
        row.appendChild(span);

        if (isSelected) {
          const check = document.createElement('span');
          check.style.marginLeft = 'auto';
          check.innerHTML = '<svg style="width: 13px; height: 13px; display: block;" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>';
          row.appendChild(check);
        }

        container.appendChild(row);
      });
    }

    function setTimeRange(val) {
      currentTimeRange = val;
      renderTimeDropdown();
      closeDropdown('time');
      currentOffset = 0;
      openDrawers.clear();
      updateClearFilterState();
      fetchAuditLogs();
    }

    const SORT_OPTIONS = [
      { value: 'time-desc', label: 'Newest First' },
      { value: 'time-asc', label: 'Oldest First' },
      { value: 'class-desc', label: 'Severity (High to Low)' },
      { value: 'class-asc', label: 'Severity (Low to High)' },
    ];

    function renderSortDropdown() {
      const container = document.getElementById('sortItemsContainer');
      const labelEl = document.getElementById('sortSelectLabel');
      const btn = document.getElementById('sortDropdownBtn');
      if (!container) return;
      container.innerHTML = '';

      const found = SORT_OPTIONS.find(s => s.value === currentSort) || SORT_OPTIONS[0];
      if (labelEl) labelEl.textContent = found.label;
      if (btn) btn.title = `Sort: ${found.label}`;

      SORT_OPTIONS.forEach(item => {
        const isSelected = item.value === currentSort;
        const row = document.createElement('div');
        row.className = 'multiselect-item' + (isSelected ? ' selected' : '');
        row.onclick = (e) => {
          e.stopPropagation();
          setSort(item.value);
        };

        const span = document.createElement('span');
        span.textContent = item.label;
        row.appendChild(span);

        if (isSelected) {
          const check = document.createElement('span');
          check.style.marginLeft = 'auto';
          check.innerHTML = '<svg style="width: 13px; height: 13px; display: block;" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>';
          row.appendChild(check);
        }

        container.appendChild(row);
      });
    }

    function setSort(val) {
      currentSort = val;
      renderSortDropdown();
      closeDropdown('sort');
      currentOffset = 0;
      openDrawers.clear();
      updateSortIcons();
      updateClearFilterState();
      fetchAuditLogs();
    }

    const ALL_CLASSES = [
      { key: 'danger', label: 'Danger (Red)', indicator: 'indicator-danger' },
      { key: 'warning', label: 'Warning (Amber)', indicator: 'indicator-warning' },
      { key: 'purple', label: 'Revocation (Purple)', indicator: 'indicator-purple' },
      { key: 'success', label: 'Success (Green)', indicator: 'indicator-success' },
      { key: 'info', label: 'Info (Blue)', indicator: 'indicator-info' },
    ];

    function renderClassMultiselect() {
      const container = document.getElementById('classItemsContainer');
      if (!container) return;
      container.innerHTML = '';

      ALL_CLASSES.forEach(item => {
        const isSelected = currentClasses.includes(item.key);
        const row = document.createElement('div');
        row.className = 'multiselect-item' + (isSelected ? ' selected' : '');
        row.onclick = (e) => {
          e.stopPropagation();
          toggleClass(item.key);
        };

        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.className = 'multiselect-checkbox';
        checkbox.checked = isSelected;
        checkbox.onclick = (e) => e.stopPropagation();
        checkbox.onchange = () => toggleClass(item.key);

        const dot = document.createElement('span');
        dot.className = `class-indicator ${item.indicator}`;

        const span = document.createElement('span');
        span.textContent = item.label;

        row.appendChild(checkbox);
        row.appendChild(dot);
        row.appendChild(span);
        container.appendChild(row);
      });

      updateClassMultiselectLabel();
    }

    function updateClassMultiselectLabel() {
      const labelEl = document.getElementById('classSelectLabel');
      const btn = document.getElementById('classDropdownBtn');
      if (!labelEl) return;

      if (currentClasses.length === 0) {
        labelEl.textContent = 'All Classes';
        if (btn) btn.title = 'Filter by event classes';
      } else if (currentClasses.length === 1) {
        const found = ALL_CLASSES.find(c => c.key === currentClasses[0]);
        labelEl.textContent = found ? found.label.split(' ')[0] : currentClasses[0];
        if (btn) btn.title = `Class: ${currentClasses[0]}`;
      } else {
        labelEl.textContent = `Classes (${currentClasses.length})`;
        if (btn) btn.title = `Classes: ${currentClasses.join(', ')}`;
      }
    }

    function toggleClass(cls) {
      const idx = currentClasses.indexOf(cls);
      if (idx > -1) {
        currentClasses.splice(idx, 1);
      } else {
        currentClasses.push(cls);
      }
      renderClassMultiselect();
      currentOffset = 0;
      openDrawers.clear();
      updateClearFilterState();
      fetchAuditLogs();
    }

    function selectAllClasses(select) {
      if (select) {
        currentClasses = ALL_CLASSES.map(c => c.key);
      } else {
        currentClasses = [];
      }
      renderClassMultiselect();
      currentOffset = 0;
      openDrawers.clear();
      updateClearFilterState();
      fetchAuditLogs();
    }

    function renderEventMultiselect(eventTypes) {
      if (!Array.isArray(eventTypes)) return;
      latestEventTypes = eventTypes;
      const container = document.getElementById('eventItemsContainer');
      if (!container) return;
      container.innerHTML = '';

      const searchInput = document.getElementById('eventFilterQuickSearch');
      const filterText = (searchInput ? searchInput.value : '').trim().toLowerCase();

      const classGroups = {
        danger: { label: 'Danger', items: [] },
        warning: { label: 'Warning', items: [] },
        purple: { label: 'Revocation & Logout', items: [] },
        success: { label: 'Success', items: [] },
        info: { label: 'Info', items: [] }
      };

      for (const ev of eventTypes) {
        const c = getEventClass(ev);
        if (classGroups[c]) {
          classGroups[c].items.push(ev);
        } else {
          classGroups.info.items.push(ev);
        }
      }

      ['danger', 'warning', 'purple', 'success', 'info'].forEach(cKey => {
        const grp = classGroups[cKey];
        if (!grp || grp.items.length === 0) return;

        grp.items.sort((a, b) => a.localeCompare(b));

        const visibleItems = grp.items.filter(ev => !filterText || ev.toLowerCase().includes(filterText));
        if (visibleItems.length === 0) return;

        const title = document.createElement('div');
        title.className = 'multiselect-group-title';
        title.textContent = grp.label;
        container.appendChild(title);

        visibleItems.forEach(ev => {
          const isSelected = currentEvents.includes(ev);
          const row = document.createElement('div');
          row.className = 'multiselect-item' + (isSelected ? ' selected' : '');
          row.onclick = (e) => {
            e.stopPropagation();
            toggleEvent(ev);
          };

          const checkbox = document.createElement('input');
          checkbox.type = 'checkbox';
          checkbox.className = 'multiselect-checkbox';
          checkbox.checked = isSelected;
          checkbox.onclick = (e) => e.stopPropagation();
          checkbox.onchange = () => toggleEvent(ev);

          const span = document.createElement('span');
          span.textContent = ev;

          row.appendChild(checkbox);
          row.appendChild(span);
          container.appendChild(row);
        });
      });

      updateEventMultiselectLabel();
    }

    function updateEventMultiselectLabel() {
      const labelEl = document.getElementById('eventSelectLabel');
      const btn = document.getElementById('eventDropdownBtn');
      if (!labelEl) return;

      if (currentEvents.length === 0) {
        labelEl.textContent = 'All Event Types';
        if (btn) btn.title = 'Filter by event types';
      } else if (currentEvents.length === 1) {
        labelEl.textContent = currentEvents[0];
        if (btn) btn.title = `Event: ${currentEvents[0]}`;
      } else {
        labelEl.textContent = `Events (${currentEvents.length})`;
        if (btn) btn.title = `Events: ${currentEvents.join(', ')}`;
      }
    }

    function toggleEvent(ev) {
      if (!latestEventTypes.includes(ev)) {
        latestEventTypes.push(ev);
      }
      const idx = currentEvents.indexOf(ev);
      if (idx > -1) {
        currentEvents.splice(idx, 1);
      } else {
        currentEvents.push(ev);
      }
      renderEventMultiselect(latestEventTypes);
      currentOffset = 0;
      openDrawers.clear();
      updateClearFilterState();
      fetchAuditLogs();
    }

    function selectAllEvents(select) {
      if (select) {
        currentEvents = latestEventTypes.slice();
      } else {
        currentEvents = [];
      }
      renderEventMultiselect(latestEventTypes);
      currentOffset = 0;
      openDrawers.clear();
      updateClearFilterState();
      fetchAuditLogs();
    }

    function setClassFilter(cls) {
      toggleClass(cls);
    }

    function setEventFilter(ev) {
      toggleEvent(ev);
    }

    const DROPDOWN_KEYS = ['time', 'class', 'event', 'sort'];

    function getDropdownEls(type) {
      if (type === 'time') return { wrapper: document.getElementById('timeDropdownWrapper'), menu: document.getElementById('timeDropdownMenu') };
      if (type === 'class') return { wrapper: document.getElementById('classMultiselectWrapper'), menu: document.getElementById('classDropdownMenu') };
      if (type === 'event') return { wrapper: document.getElementById('eventMultiselectWrapper'), menu: document.getElementById('eventDropdownMenu') };
      if (type === 'sort') return { wrapper: document.getElementById('sortDropdownWrapper'), menu: document.getElementById('sortDropdownMenu') };
      return {};
    }

    function toggleDropdown(type) {
      const { wrapper, menu } = getDropdownEls(type);
      if (!wrapper || !menu) return;

      const isOpen = menu.classList.contains('open');

      // Close all other dropdowns
      DROPDOWN_KEYS.forEach(k => {
        if (k !== type) closeDropdown(k);
      });

      if (isOpen) {
        closeDropdown(type);
      } else {
        menu.classList.add('open');
        wrapper.classList.add('open');

        // Only auto-focus event quick search on desktop / non-touch
        if (type === 'event') {
          const isMobile = window.innerWidth <= 768 || ('ontouchstart' in window) || navigator.maxTouchPoints > 0;
          if (!isMobile) {
            setTimeout(() => {
              const searchInput = document.getElementById('eventFilterQuickSearch');
              if (searchInput) searchInput.focus();
            }, 50);
          }
        }
      }
    }

    function closeDropdown(type) {
      const { wrapper, menu } = getDropdownEls(type);
      if (menu) menu.classList.remove('open');
      if (wrapper) wrapper.classList.remove('open');
    }

    function closeAllDropdowns() {
      DROPDOWN_KEYS.forEach(k => closeDropdown(k));
    }

    document.addEventListener('click', (e) => {
      const insideAny = DROPDOWN_KEYS.some(k => {
        const { wrapper } = getDropdownEls(k);
        return wrapper && wrapper.contains(e.target);
      });
      if (!insideAny) {
        closeAllDropdowns();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllDropdowns();
      }
    });

    async function fetchAuditLogs() {
      const params = new URLSearchParams({
        sort: currentSort,
        search: currentSearch,
        from: getFromTimestamp(currentTimeRange),
        limit: pageSize,
        offset: currentOffset,
      });
      if (currentClasses.length > 0) {
        params.set('eventClass', currentClasses.join(','));
      }
      if (currentEvents.length > 0) {
        params.set('event', currentEvents.join(','));
      }

      try {
        const res = await fetch(`/auth/audit/api?${params.toString()}`);
        if (!res.ok) throw new Error('Failed to load audit logs');
        const data = await res.json();
        renderAuditLogs(data);
      } catch (err) {
        console.error('Audit fetch error:', err);
      }
    }

    const openDrawers = new Set();

    function renderAuditLogs(data) {
      const tbody = document.getElementById('auditTableBody');
      const emptyEl = document.getElementById('auditEmptyState');

      if (typeof updateClearFilterState === 'function') {
        updateClearFilterState();
      }

      if (data.eventTypes) {
        renderEventMultiselect(data.eventTypes);
      }

      // Preserve currently open drawer IDs before clearing DOM
      document.querySelectorAll('.audit-drawer-row.open').forEach(el => {
        const id = el.id.replace(/^drawer-/, '');
        if (id) openDrawers.add(id);
      });

      tbody.innerHTML = '';

      if (data.stats) {
        if (document.getElementById('statAlerts')) document.getElementById('statAlerts').textContent = data.stats.securityAlerts24h || 0;
        const warningsVal = (data.stats.warnings24h !== undefined ? data.stats.warnings24h : data.stats.lockouts24h) || 0;
        if (document.getElementById('statWarnings')) document.getElementById('statWarnings').textContent = warningsVal;
        if (document.getElementById('statLockouts')) document.getElementById('statLockouts').textContent = warningsVal;
        if (document.getElementById('statLogins')) document.getElementById('statLogins').textContent = data.stats.logins24h || 0;
        if (document.getElementById('statTotal')) document.getElementById('statTotal').textContent = data.stats.total24h || 0;
        if (document.getElementById('statIps')) document.getElementById('statIps').textContent = data.stats.uniqueIps24h || 0;
      }

      const logs = data.logs || [];
      const visibleCount = logs.length;
      const totalAvailable = data.total || 0;
      const filteredCount = (typeof data.filteredCount === 'number') ? data.filteredCount : totalAvailable;

      const countVisibleEl = document.getElementById('countVisible');
      const countTotalEl = document.getElementById('countTotal');
      const filteredMatchNote = document.getElementById('filteredMatchNote');
      const countFilteredMatch = document.getElementById('countFilteredMatch');

      if (countVisibleEl) countVisibleEl.textContent = visibleCount;
      if (countTotalEl) countTotalEl.textContent = totalAvailable;

      if (filteredMatchNote) {
        if (filteredCount < totalAvailable) {
          filteredMatchNote.style.display = 'inline';
          if (countFilteredMatch) countFilteredMatch.textContent = filteredCount;
          const labelEl = document.getElementById('filteredMatchLabel');
          if (labelEl) labelEl.textContent = filteredCount === 1 ? 'matching filter' : 'matching filters';
        } else {
          filteredMatchNote.style.display = 'none';
        }
      }
      document.getElementById('lastUpdatedText').textContent = 'Updated ' + new Date().toLocaleTimeString();
      scheduleMetaDotCheck();

      const sizeSelect = document.getElementById('pageSizeSelect');
      if (sizeSelect && sizeSelect.value !== String(pageSize)) {
        sizeSelect.value = String(pageSize);
      }

      if (logs.length === 0) {
        emptyEl.style.display = 'block';
      } else {
        emptyEl.style.display = 'none';

        logs.forEach((log) => {
          const logId = String(log.id || `${new Date(log.timestamp).getTime()}-${log.event}`);
          const isOpen = openDrawers.has(logId);

          const row = document.createElement('tr');
          row.id = `row-${logId}`;
          row.className = 'audit-row' + (isOpen ? ' expanded' : '');
          row.onclick = () => toggleDrawer(logId);

          const cls = getEventClass(log.event);
          const badgeCls = `badge-${cls}`;
          const d = log.details || {};
          const ip = d.ip || d.clientIp || d.approverIp || d.revokedByIp || d.deviceIp || d.desktopIp || '-';
          const device = d.friendlyDevice || d.device || d.targetDevice || d.approverDevice || '';
          const uuid = d.sessionId || d.uuid || '';
          const attempts = (typeof d.attempts === 'number' && d.attempts > 1) ? d.attempts : 1;

          // Format detail chips
          const chips = [];
          if (attempts > 1) {
            chips.push(`<span class="detail-chip chip-attempts ${attempts >= 10 ? 'high-intensity' : ''}"><strong>attempts:</strong> ${attempts} (${attempts - 1} debounced)</span>`);
            const firstTime = d.firstAttempt || log.timestamp;
            if (firstTime) {
              const firstDate = new Date(firstTime);
              const firstValid = !isNaN(firstDate.getTime());
              const firstTitle = firstValid ? ` title="First attempt: ${escapeHtml(firstDate.toISOString())}"` : '';
              const firstFmt = firstValid ? firstDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : firstTime;
              chips.push(`<span class="detail-chip"${firstTitle}><strong>first:</strong> ${escapeHtml(firstFmt)}</span>`);
            }
            if (d.lastAttempt) {
              const lastDate = new Date(d.lastAttempt);
              const lastValid = !isNaN(lastDate.getTime());
              const lastTitle = lastValid ? ` title="Last attempt: ${escapeHtml(lastDate.toISOString())}"` : '';
              const lastFmt = lastValid ? lastDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : d.lastAttempt;
              chips.push(`<span class="detail-chip"${lastTitle}><strong>last:</strong> ${escapeHtml(lastFmt)}</span>`);
            }
          }
          for (const [k, v] of Object.entries(d)) {
            if (['ip', 'clientIp', 'approverIp', 'friendlyDevice', 'device', 'targetDevice', 'approverDevice', 'userAgent', 'sessionId', 'uuid', 'attempts', 'firstAttempt', 'lastAttempt'].includes(k)) continue;
            const strVal = typeof v === 'object' ? JSON.stringify(v) : String(v);
            chips.push(`<span class="detail-chip"><strong>${k}:</strong> ${escapeHtml(strVal)}</span>`);
          }

          row.innerHTML = `
            <td class="col-time">
              <div class="time-rel">${formatRelativeTime(log.timestamp)}</div>
              <div class="time-full">${new Date(log.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })}</div>
            </td>
            <td>
              <span class="event-badge ${badgeCls}" data-event="${escapeHtml(log.event)}" onclick="event.stopPropagation(); setEventFilter(this.dataset.event)" title="Filter by '${escapeHtml(log.event)}'">
                ${escapeHtml(log.event)}
              </span>
              <div class="col-actor-mobile">
                <span class="ip-text">${escapeHtml(ip)}</span>
                ${device ? `<span class="device-pill">${escapeHtml(device)}</span>` : ''}
                ${uuid ? `<span class="device-uuid" title="UUID: ${escapeHtml(uuid)} (Click to copy)" onclick="event.stopPropagation(); copyUuid(this, '${escapeHtml(uuid)}')">${escapeHtml(uuid)}</span>` : ''}
              </div>
            </td>
            <td>
              <div class="col-actor">
                <span class="ip-text">${escapeHtml(ip)}</span>
                ${device ? `<span class="device-pill">${escapeHtml(device)}</span>` : ''}
                ${uuid ? `<span class="device-uuid" title="UUID: ${escapeHtml(uuid)} (Click to copy)" onclick="event.stopPropagation(); copyUuid(this, '${escapeHtml(uuid)}')">${escapeHtml(uuid)}</span>` : ''}
              </div>
            </td>
            <td>
              <div class="col-details">
                ${chips.join('') || '<span style="color: #64748b; font-size: 0.75rem;">None</span>'}
              </div>
            </td>
          `;

          // Hidden expandable JSON drawer row
          const drawerRow = document.createElement('tr');
          drawerRow.id = `drawer-${logId}`;
          drawerRow.className = 'audit-drawer-row' + (isOpen ? ' open' : '');

          // Clean log object for JSON display: omit attempts/firstAttempt/lastAttempt when attempts <= 1
          const jsonLog = { ...log };
          if (jsonLog.details) {
            jsonLog.details = { ...jsonLog.details };
            if (!jsonLog.details.attempts || jsonLog.details.attempts <= 1) {
              delete jsonLog.details.attempts;
              delete jsonLog.details.firstAttempt;
              delete jsonLog.details.lastAttempt;
            } else {
              // Enforce property order in JSON: 1. attempts, 2. firstAttempt, 3. lastAttempt
              const att = jsonLog.details.attempts;
              const fa = jsonLog.details.firstAttempt || jsonLog.timestamp;
              const la = jsonLog.details.lastAttempt;
              delete jsonLog.details.attempts;
              delete jsonLog.details.firstAttempt;
              delete jsonLog.details.lastAttempt;
              jsonLog.details.attempts = att;
              if (fa) jsonLog.details.firstAttempt = fa;
              if (la) jsonLog.details.lastAttempt = la;
            }
          }

          drawerRow.innerHTML = `
            <td colspan="4" class="audit-drawer-content">
              <pre class="json-view">${escapeHtml(JSON.stringify(jsonLog, null, 2))}</pre>
            </td>
          `;

          tbody.appendChild(row);
          tbody.appendChild(drawerRow);
        });
      }

      // Pagination
      const pageNum = Math.floor(currentOffset / pageSize) + 1;
      const totalPages = Math.ceil(filteredCount / pageSize) || 1;
      document.getElementById('paginationInfo').textContent = `Page ${pageNum} of ${totalPages}`;
      document.getElementById('btnPrevPage').disabled = currentOffset <= 0;
      document.getElementById('btnNextPage').disabled = currentOffset + pageSize >= filteredCount;
    }

    function toggleDrawer(id) {
      const logId = String(id);
      const el = document.getElementById(`drawer-${logId}`);
      const row = document.getElementById(`row-${logId}`);
      if (!el) return;
      if (openDrawers.has(logId)) {
        openDrawers.delete(logId);
        el.classList.remove('open');
        if (row) row.classList.remove('expanded');
      } else {
        openDrawers.add(logId);
        el.classList.add('open');
        if (row) row.classList.add('expanded');
      }
    }

    function changePage(direction) {
      currentOffset = Math.max(0, currentOffset + direction * pageSize);
      openDrawers.clear();
      fetchAuditLogs();
    }

    function changePageSize(val) {
      const parsed = parseInt(val, 10);
      if (![25, 50, 100, 200].includes(parsed)) return;
      pageSize = parsed;
      try {
        localStorage.setItem('audit_page_size', String(pageSize));
      } catch (_) {}
      currentOffset = 0;
      openDrawers.clear();
      fetchAuditLogs();
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function copyUuid(el, text) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text);
        const originalText = el.textContent;
        el.textContent = 'Copied!';
        el.style.color = '#34d399';
        setTimeout(() => {
          el.textContent = originalText;
          el.style.color = '';
        }, 1200);
      }
    }

    function exportData(format) {
      const params = new URLSearchParams({
        format,
        sort: currentSort,
        search: currentSearch,
        from: getFromTimestamp(currentTimeRange),
      });
      if (currentClasses.length > 0) {
        params.set('eventClass', currentClasses.join(','));
      }
      if (currentEvents.length > 0) {
        params.set('event', currentEvents.join(','));
      }
      window.location.href = `/auth/audit/export?${params.toString()}`;
    }

    function toggleAutoRefresh() {
      autoRefreshEnabled = !autoRefreshEnabled;
      const btns = document.querySelectorAll('.btn-auto-refresh');
      btns.forEach((btn) => {
        if (autoRefreshEnabled) {
          btn.textContent = 'Auto: On';
          btn.style.color = '#38bdf8';
        } else {
          btn.textContent = 'Auto: Off';
          btn.style.color = '#94a3b8';
        }
      });
      if (autoRefreshEnabled) {
        startPolling();
      } else {
        if (autoRefreshTimer) clearInterval(autoRefreshTimer);
      }
    }

    async function manualRefresh() {
      const icons = document.querySelectorAll('.refresh-icon');
      icons.forEach(ic => ic.classList.add('spinning'));
      try {
        await fetchAuditLogs();
      } finally {
        setTimeout(() => {
          icons.forEach(ic => ic.classList.remove('spinning'));
        }, 650);
      }
    }

    let checkMetaScheduled = false;
    function scheduleMetaDotCheck() {
      if (checkMetaScheduled) return;
      checkMetaScheduled = true;
      requestAnimationFrame(() => {
        checkMetaScheduled = false;
        updateMetaDotVisibility();
      });
    }

    function updateMetaDotVisibility() {
      const countSpan = document.getElementById('countSummarySpan');
      const updateText = document.getElementById('lastUpdatedText');
      const updateDot = document.getElementById('updateDot');
      if (!countSpan || !updateText || !updateDot) return;

      // Temporarily set inline to check true geometry under flex-wrap
      updateDot.style.display = 'inline';
      const isWrapped = updateText.offsetTop > countSpan.offsetTop;
      updateDot.style.display = isWrapped ? 'none' : 'inline';

      const clearBtn = document.getElementById('btnClearFilters');
      const clearDot = document.getElementById('clearDot');
      if (clearBtn && clearDot && clearBtn.style.display !== 'none') {
        clearDot.style.display = 'inline';
        const isClearWrapped = clearBtn.offsetTop > updateText.offsetTop;
        clearDot.style.display = isClearWrapped ? 'none' : 'inline';
      }
    }

    function updateClearFilterState() {
      const isFiltered = Boolean(
        (currentSearch && currentSearch.trim() !== '') ||
        (currentClasses && currentClasses.length > 0) ||
        (currentEvents && currentEvents.length > 0) ||
        (currentTimeRange && currentTimeRange !== '24h') ||
        (currentSort && currentSort !== 'time-desc')
      );
      const btn = document.getElementById('btnClearFilters');
      const dot = document.getElementById('clearDot');
      if (btn) btn.style.display = isFiltered ? 'inline-flex' : 'none';
      if (dot) dot.style.display = isFiltered ? 'inline' : 'none';
      scheduleMetaDotCheck();
    }

    function clearAllFilters() {
      currentSearch = '';
      currentTimeRange = '24h';
      currentClasses = [];
      currentEvents = [];
      currentSort = 'time-desc';
      currentOffset = 0;

      const searchInput = document.getElementById('searchInput');
      if (searchInput) searchInput.value = '';

      renderTimeDropdown();
      renderSortDropdown();
      renderClassMultiselect();
      renderEventMultiselect(latestEventTypes);

      openDrawers.clear();
      updateSortIcons();
      updateClearFilterState();
      fetchAuditLogs();
    }

    function startPolling() {
      if (autoRefreshTimer) clearInterval(autoRefreshTimer);
      autoRefreshTimer = setInterval(() => {
        if (autoRefreshEnabled && currentOffset === 0) {
          fetchAuditLogs();
        }
      }, 5000);
    }

    function updateSortIcons() {
      const timeIcon = document.getElementById('sortIconTime');
      const classIcon = document.getElementById('sortIconClass');

      renderSortDropdown();

      if (timeIcon) {
        timeIcon.classList.remove('active');
        if (currentSort === 'time-desc') {
          timeIcon.textContent = '▼';
          timeIcon.classList.add('active');
        } else if (currentSort === 'time-asc') {
          timeIcon.textContent = '▲';
          timeIcon.classList.add('active');
        } else {
          timeIcon.textContent = '↕';
        }
      }

      if (classIcon) {
        classIcon.classList.remove('active');
        if (currentSort === 'class-desc') {
          classIcon.textContent = '▼';
          classIcon.classList.add('active');
        } else if (currentSort === 'class-asc') {
          classIcon.textContent = '▲';
          classIcon.classList.add('active');
        } else {
          classIcon.textContent = '↕';
        }
      }
    }

    function cycleSort(type) {
      if (type === 'class') {
        if (currentSort === 'class-desc') {
          currentSort = 'class-asc';
        } else if (currentSort === 'class-asc') {
          currentSort = 'time-desc';
        } else {
          currentSort = 'class-desc';
        }
      } else if (type === 'time') {
        if (currentSort === 'time-desc') {
          currentSort = 'time-asc';
        } else {
          currentSort = 'time-desc';
        }
      }
      currentOffset = 0;
      openDrawers.clear();
      updateSortIcons();
      fetchAuditLogs();
    }

    // Search input with 300ms debounce
    let searchDebounce = null;
    document.getElementById('searchInput').addEventListener('input', (e) => {
      currentSearch = e.target.value;
      updateClearFilterState();
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(() => {
        currentOffset = 0;
        openDrawers.clear();
        fetchAuditLogs();
      }, 300);
    });

    // Quick search input inside event multiselect
    const eventQuickSearch = document.getElementById('eventFilterQuickSearch');
    if (eventQuickSearch) {
      eventQuickSearch.addEventListener('input', () => {
        renderEventMultiselect(latestEventTypes);
      });
      eventQuickSearch.addEventListener('click', (e) => e.stopPropagation());
      eventQuickSearch.addEventListener('keydown', (e) => e.stopPropagation());
    }

    // Initial load & dropdowns initialization
    renderTimeDropdown();
    renderSortDropdown();
    renderClassMultiselect();
    renderEventMultiselect(latestEventTypes);
    fetchAuditLogs();
    startPolling();
    window.addEventListener('resize', scheduleMetaDotCheck);
    if (window.ResizeObserver) {
      const metaStatusEl = document.querySelector('.meta-status');
      if (metaStatusEl) {
        new ResizeObserver(scheduleMetaDotCheck).observe(metaStatusEl);
      }
    }
  </script>
  <%- include('partials/pwa-sw') %>
</body>
</html>

