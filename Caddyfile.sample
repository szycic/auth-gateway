{
	email dev@szycic.com
}

# Centralized Authentication Portal
auth.szycic.com {
	reverse_proxy auth-gateway:3000

	header {
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
	}
}

# Pingvin Share Service (Protected via auth.szycic.com)
share.szycic.com {
	# 1. Direct login redirect to central auth service
	handle /login* {
		redir https://auth.szycic.com/login?redirect=https://share.szycic.com/ 302
	}

	# 2. Public Static Assets (bypasses forward auth)
	handle /_next/static/* {
		reverse_proxy share-app:3000
	}

	handle /img/* {
		reverse_proxy share-app:3000
	}

	handle /favicon.ico {
		reverse_proxy share-app:3000
	}

	handle /robots.txt {
		reverse_proxy share-app:3000
	}

	# 3. Public Share Download and Reverse Share Routes
	handle /s/* {
		reverse_proxy share-app:3000
	}

	handle /share/* {
		reverse_proxy share-app:3000
	}

	handle /upload/* {
		reverse_proxy share-app:3000
	}

	# Next.js client-side route data for public shares & reverse shares
	handle /_next/data/*/s/* {
		reverse_proxy share-app:3000
	}

	handle /_next/data/*/share/* {
		reverse_proxy share-app:3000
	}

	handle /_next/data/*/upload/* {
		reverse_proxy share-app:3000
	}

	# Public backend APIs for share downloads, reverse shares, and app configuration
	handle /api/shares* {
		reverse_proxy share-app:3000
	}

	handle /api/reverseShares* {
		reverse_proxy share-app:3000
	}

	handle /api/configs* {
		reverse_proxy share-app:3000
	}

	# 4. Protected Routes (Forward Auth required for /, /account, /admin, etc.)
	handle {
		forward_auth auth-gateway:3000 {
			uri /auth/verify
			copy_headers X-Auth-Status X-Auth-Role
			@unauthorized status 401
			handle_response @unauthorized {
				error 401
			}
		}
		reverse_proxy auth-gateway:3000
	}

	# 5. Intelligent handling of 401 Unauthorized errors
	handle_errors {
		@nextData expression {http.error.status_code} == 401 && (path('/_next/data/*') || header({'x-nextjs-data': '*'}))
		handle @nextData {
			header Content-Type "application/json"
			respond `{"pageProps":{"__N_REDIRECT":"https://auth.szycic.com/login?redirect=https://share.szycic.com","__N_REDIRECT_STATUS":307}}` 200
		}

		@api expression {http.error.status_code} == 401 && path('/api/*')
		handle @api {
			header Content-Type "application/json"
			respond `{"statusCode":401,"message":"Authentication required","redirect":"https://auth.szycic.com/login?redirect=https://share.szycic.com"}` 401
		}

		handle {
			redir * https://auth.szycic.com/login?redirect={scheme}://{host}{uri} 302
		}
	}

	# Security headers
	header {
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
	}
}

# IT Tools Service (Protected via auth.example.com)
tools.example.com {
	# 1. Direct login redirect to central auth service
	handle /login* {
		redir https://auth.example.com/login?redirect=https://tools.example.com/ 302
	}

	# 2. Forward Auth Protected Routes
	handle {
		forward_auth auth-gateway:3000 {
			uri /auth/verify
			copy_headers X-Auth-Status X-Auth-Role
			@unauthorized status 401
			handle_response @unauthorized {
				error 401
			}
		}
		reverse_proxy auth-gateway:3000
	}

	# 3. Intelligent handling of 401 Unauthorized errors
	handle_errors {
		handle {
			redir * https://auth.example.com/login?redirect={scheme}://{host}{uri} 302
		}
	}

	# Security headers
	header {
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
	}
}

# Quartz Digital Garden (Protected via auth.example.com)
garden.example.com {
	encode gzip

	# 1. Direct login redirect to central auth service
	handle /login* {
		redir https://auth.example.com/login?redirect=https://garden.example.com/ 302
	}

	# 2. Immutable Cache for Quartz Hashed Assets
	@hashed path_regexp hashed -[0-9a-f]{8}\.(css|js)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# 3. Forward Auth Protected Routes
	handle {
		forward_auth auth-gateway:3000 {
			uri /auth/verify
			copy_headers X-Auth-Status X-Auth-Role
			@unauthorized status 401
			handle_response @unauthorized {
				error 401
			}
		}
		reverse_proxy auth-gateway:3000
	}

	# 4. Intelligent handling of 401 Unauthorized errors
	handle_errors {
		@unauthorized expression {http.error.status_code} == 401
		handle @unauthorized {
			redir * https://auth.example.com/login?redirect={scheme}://{host}{uri} 302
		}
	}

	# Security headers
	header {
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
	}
}

# Uptime Kuma Service (Protected via auth.example.com)
uptime.example.com {
	# 1. Direct login redirect to central auth service
	handle /login* {
		redir https://auth.example.com/login?redirect=https://uptime.example.com/ 302
	}

	# 2. Public Push Monitor Webhooks (bypasses forward auth)
	handle /api/push/* {
		reverse_proxy kuma:3001
	}

	# 3. WebSocket traffic for Uptime Kuma (forward_auth check, then direct to kuma:3001)
	handle /socket.io/* {
		forward_auth auth-gateway:3000 {
			uri /auth/verify
			copy_headers X-Auth-Status X-Auth-Role
			@unauthorized status 401
			handle_response @unauthorized {
				error 401
			}
		}
		reverse_proxy kuma:3001
	}

	# 3. Forward Auth Protected Routes with auth-watchdog injection
	handle {
		forward_auth auth-gateway:3000 {
			uri /auth/verify
			copy_headers X-Auth-Status X-Auth-Role
			@unauthorized status 401
			handle_response @unauthorized {
				error 401
			}
		}
		reverse_proxy auth-gateway:3000
	}

	# 3. Intelligent handling of 401 Unauthorized errors
	handle_errors {
		@unauthorized expression {http.error.status_code} == 401
		handle @unauthorized {
			redir * https://auth.example.com/login?redirect={scheme}://{host}{uri} 302
		}
	}

	# Security headers
	header {
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
	}
}

# Dozzle Service (Protected via auth.example.com)
dozzle.example.com {
	# 1. Direct login redirect to central auth service
	handle /login* {
		redir https://auth.example.com/login?redirect=https://dozzle.example.com/ 302
	}

	# 2. Real-time streaming APIs & WebSockets (checked via forward_auth, then direct to dozzle:8080)
	handle /api/* {
		forward_auth auth-gateway:3000 {
			uri /auth/verify
			copy_headers X-Auth-Status X-Auth-Role
			@unauthorized status 401
			handle_response @unauthorized {
				error 401
			}
		}
		reverse_proxy dozzle:8080
	}

	# 3. Web UI routes with auth-watchdog injection
	handle {
		forward_auth auth-gateway:3000 {
			uri /auth/verify
			copy_headers X-Auth-Status X-Auth-Role
			@unauthorized status 401
			handle_response @unauthorized {
				error 401
			}
		}
		reverse_proxy auth-gateway:3000
	}

	# 4. Intelligent handling of 401 Unauthorized errors
	handle_errors {
		@unauthorized expression {http.error.status_code} == 401
		handle @unauthorized {
			redir * https://auth.example.com/login?redirect={scheme}://{host}{uri} 302
		}
	}

	# Security headers
	header {
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
	}
}

# Catch-all block for unmapped subdomains
*.example.com {
	respond "Not Found" 404
}


