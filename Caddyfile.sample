# System Monitoring & Observability
# ==============================================================================

# Uptime Kuma Service (Protected via auth.example.com)
uptime.example.com {
	# 1. Public Push Monitor Webhooks (bypasses forward auth)
	handle /api/push/* {
		reverse_proxy kuma:3001
	}

	# 2. WebSocket traffic for Uptime Kuma (forward_auth check, then direct to kuma:3001)
	handle /socket.io/* {
		forward_auth auth-gateway:3000 {
			uri /auth/verify
			copy_headers X-Auth-Status X-Auth-Role
			@unauthorized status 401
			handle_response @unauthorized {
				error 401
			}
		}
		reverse_proxy kuma:3001
	}

	# 3. Forward Auth Protected Routes with auth-watchdog injection
	handle {
		forward_auth auth-gateway:3000 {
			uri /auth/verify
			copy_headers X-Auth-Status X-Auth-Role
			@unauthorized status 401
			handle_response @unauthorized {
				error 401
			}
		}
		reverse_proxy auth-gateway:3000
	}

	# 4. Intelligent handling of 401 Unauthorized errors
	handle_errors {
		@unauthorized expression {http.error.status_code} == 401
		handle @unauthorized {
			redir * https://auth.example.com/login?redirect={scheme}://{host}{uri} 302
		}
	}

	import security_headers
}

