{
  "app": {
    "name": "Auth Gateway",
    "subtitle": "Scan the QR code with authenticated mobile device to approve access for this desktop.",
    "footerText": "auth.example.com"
  },
  "server": {
    "port": 3000,
    "host": "0.0.0.0",
    "baseUrl": "https://auth.example.com"
  },
  "session": {
    "cookieDomain": ".example.com",
    "authCookieName": "gateway_auth_token",
    "approverCookieName": "gateway_approver_session",
    "sessionTtlHours": 72,
    "qrSessionTtlMs": 120000,
    "approverTtlDays": 30
  },
  "services": [
    {
      "id": "share",
      "name": "Pingvin Share",
      "subtitle": "Secure file sharing & storage portal",
      "url": "https://share.example.com",
      "upstream": "http://share-app:3000",
      "allowedRedirects": ["https://share.example.com*"]
    },
    {
      "id": "tools",
      "name": "IT Tools",
      "subtitle": "Handy collection of developer utilities",
      "url": "https://tools.example.com",
      "upstream": "http://it-tools:80",
      "allowedRedirects": ["https://tools.example.com*"]
    },
    {
      "id": "garden",
      "name": "Digital Garden",
      "subtitle": "Personal knowledge base & digital garden",
      "url": "https://garden.example.com",
      "upstream": "http://garden:8080",
      "allowedRedirects": ["https://garden.example.com*"]
    },
    {
      "id": "uptime",
      "name": "Uptime Kuma",
      "subtitle": "Service monitoring & uptime status",
      "url": "https://uptime.example.com",
      "upstream": "http://kuma:3001",
      "allowedRedirects": ["https://uptime.example.com*"]
    },
    {
      "id": "dozzle",
      "name": "Dozzle",
      "subtitle": "Real-time Docker container log viewer",
      "url": "https://dozzle.example.com",
      "upstream": "http://dozzle:8080",
      "allowedRedirects": ["https://dozzle.example.com*"]
    },
    {
      "id": "glances",
      "name": "Glances",
      "subtitle": "System monitoring & performance dashboard",
      "url": "https://glances.example.com",
      "upstream": "http://glances:61208",
      "allowedRedirects": ["https://glances.example.com*"]
    },
    {
      "id": "pdf",
      "name": "Stirling PDF",
      "subtitle": "Locally hosted PDF manipulation & conversion suite",
      "url": "https://pdf.example.com",
      "upstream": "http://stirling-pdf:8080",
      "allowedRedirects": ["https://pdf.example.com*"]
    }
  ]
}
